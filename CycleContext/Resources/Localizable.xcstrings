    "cycle.content.premenstrual.todayText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Periode können Belastbarkeit und Reizschwelle sinken. Das Muster ist sehr individuell."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Before a period, resilience and the threshold for irritation may decrease. The pattern is highly individual."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Before a period, resilience and the threshold for irritation may decrease. The pattern is highly individual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant les règles, la résistance au stress et le seuil de tolérance à l’irritation peuvent diminuer. Cela varie beaucoup d’une personne à l’autre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de la menstruación, la resistencia al estrés y el umbral de irritabilidad pueden disminuir. El patrón es muy individual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes da menstruação, a capacidade de lidar com o estresse e a tolerância à irritação podem diminuir. O padrão é muito individual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima delle mestruazioni, energia e tolleranza alle irritazioni possono diminuire. Lo schema è molto personale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед менструацией силы и терпимость к раздражителям могут снижаться. У каждой женщины это происходит по-своему."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تقل الطاقة والقدرة على تحمل المثيرات قبل الحيض. ويختلف النمط كثيرًا من شخص لآخر."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "月經前，承受壓力的能力與容忍刺激的程度可能降低，但每個人的情況差異很大。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月经前，承受压力的能力与容忍刺激的程度可能降低，但每个人的情况差异很大。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני הווסת ייתכנו ירידה ביכולת להתמודד עם עומס וסף גירוי נמוך יותר. הדפוס אישי מאוד."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月経前には負担に弱くなったり、いら立ちやすくなったりすることがあります。個人差が大きい変化です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생리 전에는 스트레스를 견디는 힘이 줄고 예민해질 수 있습니다. 개인차가 큰 변화입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माहवारी से पहले सहनशक्ति और चिड़चिड़ेपन की सीमा कम हो सकती है। यह पैटर्न पूरी तरह व्यक्तिगत है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед менструацією витривалість і поріг дратівливості можуть знижуватися. Шаблон дуже індивідуальний."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนมีประจำเดือน ความพร้อมในการรับมือและเกณฑ์ความหงุดหงิดอาจลดลง รูปแบบแตกต่างกันมากในแต่ละคน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước kỳ kinh, sức chịu đựng và ngưỡng cáu gắt có thể giảm. Khuôn mẫu rất khác nhau ở từng người."
          }
        }
      }
    },
