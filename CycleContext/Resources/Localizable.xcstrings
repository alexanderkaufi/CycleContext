    "dashboard.example.explanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ansicht verwendet Beispiel- und Standardwerte. Erst ein eingetragener echter Periodenbeginn macht die zeitliche Einordnung persönlich."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This view uses example and default values. The timing becomes personal only after you enter an actual period start."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This view uses example and default values. The timing becomes personal only after you enter an actual period start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vue utilise des valeurs d’exemple et des valeurs par défaut. Les dates ne deviennent personnelles qu’après la saisie d’un début réel de règles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vista utiliza valores de ejemplo y predeterminados. Las fechas solo se vuelven personales después de introducir un inicio real de la menstruación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tela usa valores de exemplo e valores padrão. As datas só se tornam pessoais depois que você informa o início real de uma menstruação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa schermata usa valori di esempio e predefiniti. I tempi diventano personali solo dopo aver inserito l'inizio effettivo delle mestruazioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь используются примерные значения и настройки по умолчанию. Расчёт станет персональным только после ввода фактической даты начала менструации."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم هذا العرض قيمًا توضيحية وافتراضية. ولا يصبح التوقيت شخصيًا إلا بعد إدخال بداية حيض فعلية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此畫面使用示範和預設數值。只有輸入實際的月經開始日後，時間估計才會反映個人情況。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此画面使用示例和默认数值。只有输入实际的月经开始日后，时间估计才会反映个人情况。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תצוגה זו משתמשת בערכים לדוגמה ובערכי ברירת מחדל. התזמון הופך לאישי רק לאחר הזנת תאריך התחלה אמיתי של הווסת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面は例の値と初期値を使用しています。実際の月経開始日を入力すると、時期を個人に合わせて表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면은 예시 값과 기본값을 사용합니다. 실제 생리 시작일을 입력해야 시기를 개인에 맞춰 표시할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह दृश्य उदाहरण और डिफ़ॉल्ट मानों का उपयोग करता है। वास्तविक माहवारी की शुरुआत दर्ज करने के बाद ही समय व्यक्तिगत बनता है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей екран використовує приклади й типові значення. Час стане персональним лише після введення фактичного початку менструації."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมมองนี้ใช้ค่าตัวอย่างและค่าเริ่มต้น การจัดช่วงเวลาจะเป็นข้อมูลเฉพาะบุคคลเมื่อคุณป้อนวันเริ่มมีประจำเดือนจริงแล้วเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ xem này sử dụng giá trị mẫu và mặc định. Thời gian chỉ trở thành dữ liệu cá nhân sau khi bạn nhập ngày bắt đầu kỳ kinh thực tế."
          }
        }
      }
    },
