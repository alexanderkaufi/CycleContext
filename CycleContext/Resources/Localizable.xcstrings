        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这五个阶段是否适用，取决于使用的避孕方法。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאלה אם חמש התקופות מתאימות תלויה באמצעי המניעה שבו משתמשים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "五つの時期が当てはまるかどうかは、使っている避妊法によって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다섯 시기가 적용되는지는 사용하는 피임법에 따라 다릅니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाँच खंड लागू होते हैं या नहीं, यह इस्तेमाल किए जा रहे गर्भनिरोधक तरीके पर निर्भर है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи застосовні п’ять розділів, залежить від методу контрацепції."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะทั้งห้าจะใช้ได้หรือไม่ขึ้นอยู่กับวิธีคุมกำเนิดที่ใช้"
