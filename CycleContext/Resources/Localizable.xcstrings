    "privacy.storage.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile, Zyklusdaten, Einträge und Angaben zum Befinden werden lokal auf diesem iPhone gespeichert. Es gibt kein Konto und keine Synchronisierung mit einem eigenen Server. Reguläre iPhone-Backups können App-Daten enthalten."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles, cycle data, entries, and wellbeing information are stored locally on this iPhone. There is no account and no synchronisation with a dedicated server. Regular iPhone backups may include app data."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiles, cycle data, entries, and wellbeing information are stored locally on this iPhone. There is no account and no synchronization with a dedicated server. Regular iPhone backups may include app data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils, les données du cycle, les entrées et les informations sur le bien-être sont stockés localement sur cet iPhone. Il n’y a ni compte ni synchronisation avec un serveur dédié. Les sauvegardes régulières de l’iPhone peuvent inclure les données de l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles, los datos del ciclo, las entradas y la información de bienestar se guardan localmente en este iPhone. No hay cuenta ni sincronización con un servidor dedicado. Las copias de seguridad habituales del iPhone pueden incluir los datos de la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfis, dados do ciclo, registros e informações sobre o bem-estar são armazenados localmente neste iPhone. Não há conta nem sincronização com um servidor dedicado. Os backups regulares do iPhone podem incluir os dados do app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili, dati del ciclo, voci e informazioni sul benessere sono salvati localmente su questo iPhone. Non ci sono account né sincronizzazione con un server dedicato. I normali backup dell'iPhone possono includere i dati dell'app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили, данные цикла, записи и сведения о самочувствии хранятся локально на этом iPhone. Учётная запись и синхронизация с отдельным сервером отсутствуют. Обычные резервные копии iPhone могут включать данные приложения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُخزن الملفات الشخصية وبيانات الدورة والملاحظات ومعلومات الحالة العامة محليًا على هذا الـ iPhone. لا يوجد حساب أو مزامنة مع خادم مخصص. وقد تتضمن النسخ الاحتياطية المعتادة للجهاز بيانات التطبيق."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "個人檔案、週期資料、紀錄和身體感受資訊都儲存在這部 iPhone 上。無須建立帳號，也不會與專用伺服器同步。一般 iPhone 備份可能包含 App 資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个人档案、周期数据、记录和身体感受信息都保存在这台 iPhone 上。无须建立账号，也不会与专用服务器同步。一般 iPhone 备份可能包含 App 数据。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרופילים, נתוני מחזור, רשומות ומידע על ההרגשה נשמרים מקומית ב־iPhone הזה. אין חשבון ואין סנכרון עם שרת ייעודי. גיבויים רגילים של ה־iPhone עשויים לכלול נתוני אפליקציה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール、周期データ、記録、体調に関する情報は、このiPhone内に保存されます。アカウントは不要で、専用サーバーとの同期はありません。通常のiPhoneのバックアップにアプリのデータが含まれる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필, 주기 데이터, 기록, 컨디션 정보는 이 iPhone에 로컬로 저장됩니다. 계정이 필요하지 않고 전용 서버와 동기화하지 않습니다. 일반적인 iPhone 백업에 앱 데이터가 포함될 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल, चक्र डेटा, रिकॉर्ड और स्वास्थ्य जानकारी इस iPhone पर स्थानीय रूप से सहेजी जाती है। कोई अकाउंट नहीं है और किसी समर्पित सर्वर से सिंक नहीं होता। नियमित iPhone बैकअप में ऐप का डेटा शामिल हो सकता है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профілі, дані циклу, записи й інформація про самопочуття зберігаються локально на цьому iPhone. Немає облікового запису чи синхронізації з окремим сервером. Звичайні резервні копії iPhone можуть містити дані програми."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรไฟล์ ข้อมูลรอบเดือน บันทึก และข้อมูลความรู้สึกถูกจัดเก็บไว้ใน iPhone เครื่องนี้ ไม่มีบัญชีและไม่มีการซิงค์กับเซิร์ฟเวอร์เฉพาะ การสำรองข้อมูล iPhone ตามปกติอาจรวมข้อมูลของแอป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ, dữ liệu chu kỳ, ghi chép và thông tin cảm nhận được lưu cục bộ trên iPhone này. Không có tài khoản và không đồng bộ với máy chủ riêng. Bản sao lưu iPhone thông thường có thể bao gồm dữ liệu ứng dụng."
          }
        }
      }
    },
