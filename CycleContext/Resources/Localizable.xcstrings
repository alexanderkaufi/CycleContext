          "stringUnit": {
            "state": "translated",
            "value": "Your App Store review helps others discover CycleContext and supports its continued development."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre avis sur l’App Store aide d’autres personnes à découvrir CycleContext et soutient la poursuite de son développement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu reseña en el App Store ayuda a otras personas a descubrir CycleContext y apoya su desarrollo continuo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua avaliação na App Store ajuda outras pessoas a descobrir o CycleContext e apoia a continuidade do seu desenvolvimento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua recensione sull'App Store aiuta altre persone a scoprire CycleContext e ne sostiene lo sviluppo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш отзыв в App Store поможет другим людям найти CycleContext и поддержит дальнейшую разработку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تساعد مراجعتك في App Store الآخرين على اكتشاف CycleContext وتدعم تطويره المستمر."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 App Store 的評價能協助其他人找到 CycleContext，也支持我們持續開發。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在 App Store 的评价能协助其他人找到 CycleContext，也支持我们持续开发。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדירוג שלכם ב־App Store עוזר לאחרים למצוא את CycleContext ותומך בהמשך הפיתוח שלה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeでの評価は、ほかの人がCycleContextを見つける助けとなり、開発の継続を支えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store의 평가는 다른 사람이 CycleContext를 찾는 데 도움이 되고 지속적인 개발을 응원합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी App Store समीक्षा दूसरे लोगों को CycleContext खोजने में मदद करती है और इसके आगे के विकास का समर्थन करती है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш відгук в App Store допомагає іншим знайти CycleContext і підтримує подальший розвиток програми."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีวิวของคุณใน App Store ช่วยให้ผู้อื่นค้นพบ CycleContext และสนับสนุนการพัฒนาแอปต่อไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá của bạn trên App Store giúp người khác khám phá CycleContext và hỗ trợ ứng dụng tiếp tục phát triển."
          }
        }
      }
    },
