    "dashboard.overdue.relationship": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag nach dem aktuellen Befinden und danach, was heute konkret helfen würde. Ohne bestätigten neuen Periodenbeginn sollte die App keine phasenspezifischen Bedürfnisse voraussetzen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask how they feel and what would help today. Without a confirmed new period start, the app should not assume phase-specific needs."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask how they feel and what would help today. Without a confirmed new period start, the app should not assume phase-specific needs."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez-lui comment elle se sent et ce qui l’aiderait aujourd’hui. Sans nouveau début de règles confirmé, l’app ne doit pas supposer des besoins propres à une phase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale cómo se siente y qué le ayudaría hoy. Sin un nuevo inicio de menstruación confirmado, la app no debe suponer necesidades propias de una fase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte como ela se sente e o que ajudaria hoje. Sem um novo início de menstruação confirmado, o app não deve presumir necessidades próprias de uma fase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi come si sente e cosa potrebbe aiutarla oggi. Senza un nuovo inizio confermato, l'app non deve presumere esigenze legate a una fase specifica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите, как человек себя чувствует и что поможет ему сегодня. Без подтверждённой даты нового начала не следует предполагать потребности, связанные с конкретной фазой."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل كيف تشعر اليوم وما الذي قد يساعدها. ومن دون بداية جديدة مؤكدة، لا ينبغي افتراض احتياجات خاصة بمرحلة معينة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問問她今天感覺如何、需要什麼幫助。沒有確認新的月經開始日時，不應假設她有特定階段的需求。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问她今天感觉如何、需要什么帮助。没有确认新的月经开始日时，不应假设她有特定阶段的需求。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאלו איך היא מרגישה ומה יעזור לה היום. בלי התחלה חדשה ומאושרת של הווסת, אין להניח צרכים מסוימים לפי שלב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の体調と、何が助けになるかを本人に尋ねてください。新しい月経開始日が確認されない限り、特定の時期に応じた必要を決めつけないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 컨디션과 필요한 도움을 본인에게 물어보세요. 새 생리 시작일이 확인되지 않았다면 특정 단계에 따른 필요를 가정하지 마세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूछें कि वे कैसा महसूस कर रहे हैं और आज क्या मदद करेगा। नई माहवारी की शुरुआत की पुष्टि के बिना ऐप को चरण से जुड़ी ज़रूरतें नहीं माननी चाहिए।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте, як людина почувається і що сьогодні допоможе. Без підтвердженого нового початку програма не має припускати потреби, пов’язані з фазою."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามว่าบุคคลนั้นรู้สึกอย่างไรและวันนี้สิ่งใดจะช่วยได้ หากยังไม่ยืนยันวันเริ่มใหม่ แอปไม่ควรคาดเดาความต้องการตามระยะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hỏi họ cảm thấy thế nào và hôm nay điều gì sẽ hữu ích. Nếu chưa xác nhận ngày bắt đầu mới, ứng dụng không nên mặc định các nhu cầu theo giai đoạn."
          }
        }
      }
    },
