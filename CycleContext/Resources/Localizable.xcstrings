    "cycleCorrection.explanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn bessere Informationen zum aktuellen Zyklusstand vorliegen, kannst du die zeitliche Schätzung hier anpassen. Dadurch wird kein bestätigter Periodenbeginn gespeichert."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have better information about the current cycle status, you can adjust the timing estimate here. This does not save a confirmed period start."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have better information about the current cycle status, you can adjust the timing estimate here. This does not save a confirmed period start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous disposez d’informations plus précises sur l’état actuel du cycle, vous pouvez ajuster ici l’estimation des dates. Cela n’enregistre pas un début de règles confirmé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tienes información más precisa sobre el estado actual del ciclo, puedes ajustar aquí la estimación de las fechas. Esto no guarda un inicio de menstruación confirmado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você tiver informações melhores sobre o estado atual do ciclo, poderá ajustar aqui a estimativa das datas. Isso não salva um início confirmado da menstruação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai informazioni più precise sullo stato attuale del ciclo, puoi modificare qui la stima dei tempi. Questo non salva un inizio delle mestruazioni confermato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если у вас есть более точные сведения о текущем цикле, вы можете скорректировать здесь оценку сроков. Подтверждённая дата начала менструации при этом не сохраняется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت لديك معلومات أدق عن حالة الدورة الحالية، يمكنك تعديل تقدير التوقيت هنا. لن يؤدي ذلك إلى حفظ بداية مؤكدة للحيض."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你有更準確的目前週期資訊，可以在這裡調整時間估計。這不會儲存為已確認的月經開始日。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你有更准确的目前周期信息，可以在这里调整时间估计。这不会保存为已确认的月经开始日。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם יש לכם מידע טוב יותר על מצב המחזור הנוכחי, אפשר לעדכן כאן את הערכת התזמון. פעולה זו אינה שומרת התחלה מאושרת של הווסת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の周期についてより確かな情報があれば、ここで時期の推定を調整できます。確認済みの月経開始日は保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 주기에 대해 더 확실한 정보가 있다면 여기서 시기 추정을 조정할 수 있습니다. 확인된 생리 시작일이 저장되지는 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपके पास वर्तमान चक्र स्थिति की बेहतर जानकारी है, तो आप यहाँ समय के अनुमान को समायोजित कर सकते हैं। इससे माहवारी की पुष्टि की गई शुरुआत नहीं सहेजी जाती।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви маєте точнішу інформацію про поточний стан циклу, тут можна скоригувати оцінку часу. Це не зберігає підтверджений початок менструації."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณมีข้อมูลเกี่ยวกับสถานะรอบเดือนปัจจุบันที่ดีกว่า คุณสามารถปรับการประเมินช่วงเวลาได้ที่นี่ การปรับนี้จะไม่บันทึกวันเริ่มมีประจำเดือนที่ยืนยันแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn có thông tin chính xác hơn về trạng thái chu kỳ hiện tại, bạn có thể điều chỉnh ước tính thời gian tại đây. Thao tác này không lưu ngày bắt đầu kỳ kinh đã xác nhận."
          }
        }
      }
    },
