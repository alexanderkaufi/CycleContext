    "privacy.consent.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Daten einer anderen Person nur, wenn sie davon weiß und einverstanden ist. Verwende möglichst einen Spitznamen, ein Kürzel oder eine neutrale Bezeichnung."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only record another person’s data if they know about it and agree. Whenever possible, use a nickname, initials, or a neutral label."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Only record another person’s data if they know about it and agree. Whenever possible, use a nickname, initials, or a neutral label."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’enregistrez les données d’une autre personne que si elle en est informée et y consent. Dans la mesure du possible, utilisez un surnom, des initiales ou une désignation neutre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra los datos de otra persona solo si lo sabe y está de acuerdo. Siempre que sea posible, usa un apodo, iniciales o una etiqueta neutra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre dados de outra pessoa apenas se ela souber e concordar. Sempre que possível, use um apelido, iniciais ou uma identificação neutra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i dati di un'altra persona solo se ne è a conoscenza e acconsente. Quando possibile, usa un soprannome, le iniziali o un'etichetta neutra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте данные другого человека, только если он знает об этом и согласен. По возможности используйте псевдоним, инициалы или нейтральное обозначение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تسجل بيانات شخص آخر إلا إذا كان يعلم بذلك ويوافق عليه. استخدم لقبًا أو الأحرف الأولى من الاسم أو تسمية محايدة متى أمكن."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在對方知情並同意時，才記錄她的資料。可以的話，請使用暱稱、姓名縮寫或中性稱呼。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录他人的数据时，应先取得对方的知情与同意。尽可能使用昵称、姓名首字母或中性称呼。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לתעד מידע על אדם אחר רק אם הוא יודע על כך ומסכים. כשאפשר, השתמשו בכינוי, בראשי תיבות או בתווית ניטרלית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの人のデータは、本人が知り、同意している場合だけ記録してください。可能であれば、ニックネーム、イニシャル、中立的な呼び名を使いましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람의 데이터는 본인이 알고 동의할 때만 기록하세요. 가능하면 별명, 이니셜 또는 중립적인 이름을 사용하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी अन्य व्यक्ति की जानकारी तभी दर्ज करें जब उन्हें पता हो और वे सहमत हों। जहाँ संभव हो, उपनाम, शुरुआती अक्षर या तटस्थ नाम इस्तेमाल करें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте дані іншої людини лише тоді, коли вона про це знає й погоджується. За можливості використовуйте псевдонім, ініціали або нейтральне позначення."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูลของบุคคลอื่นเมื่อพวกเขารับรู้และยินยอมเท่านั้น หากทำได้ ให้ใช้ชื่อเล่น อักษรย่อ หรือคำเรียกที่เป็นกลาง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ghi dữ liệu của người khác khi họ biết và đồng ý. Nếu có thể, hãy dùng biệt danh, chữ viết tắt hoặc nhãn trung tính."
          }
        }
      }
    },
