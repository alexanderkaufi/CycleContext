    "cycle.content.ovulation_window.todayText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nähe, Lust oder soziale Energie können sich um den Eisprung verändern, müssen es aber nicht."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Closeness, desire, or social energy may change around ovulation, but they do not have to."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Closeness, desire, or social energy may change around ovulation, but they do not have to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La proximité, le désir ou l’énergie sociale peuvent changer autour de l’ovulation, mais ce n’est pas systématique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cercanía, el deseo o las ganas de relacionarse pueden cambiar alrededor de la ovulación, pero no tienen por qué hacerlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A proximidade, o desejo ou a vontade de socializar podem mudar perto da ovulação, mas não necessariamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vicinanza, desiderio o energia sociale possono cambiare intorno all'ovulazione, ma non è detto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вблизи овуляции желание близости или общительность могут меняться, но не обязательно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تتغير الرغبة في القرب أو الاهتمام الجنسي أو التواصل قرب الإباضة، وقد لا تتغير."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵前後，親密需求、慾望或社交精力可能改變，也可能沒有變化。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵前后，亲密需求、欲望或社交精力可能改变，也可能没有变化。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קרבה, חשק או אנרגיה חברתית עשויים להשתנות סביב הביוץ, אך לא בהכרח."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵の前後に親密さへの希望や活力が変わることもありますが、必ずではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배란 전후에 친밀감에 대한 바람이나 활력이 달라질 수도 있지만 꼭 그런 것은 아닙니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंडोत्सर्जन के आसपास निकटता, इच्छा या सामाजिक ऊर्जा बदल सकती है, पर ऐसा होना आवश्यक नहीं है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Близькість, бажання чи соціальна енергія навколо овуляції можуть змінюватися, але не обов’язково."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความใกล้ชิด ความต้องการ หรือพลังงานทางสังคมอาจเปลี่ยนรอบช่วงตกไข่ แต่ไม่จำเป็นต้องเปลี่ยน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự gần gũi, ham muốn hoặc năng lượng giao tiếp có thể thay đổi quanh thời điểm rụng trứng, nhưng không nhất thiết."
          }
        }
      }
    },
    "cycle.content.premenstrual.avoidText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Witze über Aussehen oder Stimmung, Bevormundung und unnötige Grundsatzdiskussionen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid jokes about appearance or mood, patronising behaviour, and unnecessary fundamental arguments."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid jokes about appearance or mood, patronizing behavior, and unnecessary fundamental arguments."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez les plaisanteries sur l’apparence ou l’humeur, les attitudes condescendantes et les disputes de fond inutiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita las bromas sobre el aspecto o el ánimo, las actitudes condescendientes y las discusiones de fondo innecesarias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite piadas sobre aparência ou humor, atitudes condescendentes e discussões profundas desnecessárias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita battute sull'aspetto o sull'umore, atteggiamenti paternalistici e discussioni di principio non necessarie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте шуток о внешности или настроении, снисходительного тона и ненужных принципиальных споров."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجنب المزاح بشأن المظهر أو المزاج، والتعامل بتعالٍ، والخلافات الجوهرية غير الضرورية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "避免取笑外表或心情、居高臨下地對待她，以及不必要的原則性爭吵。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免取笑外表或心情、居高临下地对待她，以及不必要的原则性争吵。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להימנע מבדיחות על מראה או מצב רוח, מיחס מתנשא ומוויכוחים עקרוניים מיותרים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目や気分をからかったり、上から目線で接したり、不必要な言い争いを始めたりしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외모나 기분을 놀리거나, 깔보는 태도를 보이거나, 불필요한 다툼을 시작하지 마세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूप-रंग या मूड पर मज़ाक, उपेक्षापूर्ण व्यवहार और अनावश्यक बुनियादी बहस से बचें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уникайте жартів про зовнішність чи настрій, зверхньої поведінки й зайвих принципових суперечок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลีกเลี่ยงมุกเรื่องรูปลักษณ์หรืออารมณ์ การวางตัวแบบเหนือกว่า และการเริ่มโต้เถียงเรื่องใหญ่โดยไม่จำเป็น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tránh đùa về ngoại hình hoặc tâm trạng, cư xử trịch thượng và tranh cãi những vấn đề căn bản không cần thiết."
          }
        }
      }
    },
