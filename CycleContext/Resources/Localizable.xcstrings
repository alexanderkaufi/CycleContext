    "entry.demo.pms.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Ruhe einplanen, keine schweren Themen am Abend."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan more downtime and leave difficult topics for another evening."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan more downtime and leave difficult topics for another evening."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévoir plus de repos et remettre les sujets difficiles à une autre soirée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planificar más tiempo de descanso y dejar los temas difíciles para otra noche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planejar mais tempo para descansar e deixar assuntos difíceis para outra noite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevedere più pause e rimandare gli argomenti difficili a un'altra sera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запланировать больше времени для отдыха и отложить сложные темы на другой вечер."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخصيص وقت أطول للراحة وتأجيل المواضيع الصعبة إلى مساء آخر."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安排多一點休息時間，困難的話題留待其他晚上再談。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安排多一点休息时间，困难的话题留待其他晚上再谈。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לתכנן יותר זמן מנוחה ולדחות נושאים קשים לערב אחר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休める時間を増やし、難しい話題は別の晩にする。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬는 시간을 늘리고 어려운 이야기는 다른 날 저녁에 하기."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अधिक आराम की योजना बनाएँ और कठिन विषय किसी दूसरी शाम के लिए छोड़ दें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запланувати більше відпочинку, а складні теми залишити на інший вечір."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เผื่อเวลาพักมากขึ้น และเลื่อนเรื่องที่คุยยากไปเป็นเย็นวันอื่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dành thêm thời gian nghỉ và để những chủ đề khó sang một buổi tối khác."
          }
        }
      }
    },
