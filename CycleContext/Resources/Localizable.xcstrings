    "profile.privacyHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze möglichst nur einen Vornamen, ein Kürzel oder eine neutrale Bezeichnung. Die Daten bleiben auf dem Gerät."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only a first name, initials, or a neutral label where possible. The data stays on this device."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only a first name, initials, or a neutral label where possible. The data stays on this device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la mesure du possible, utilisez seulement un prénom, des initiales ou une désignation neutre. Les données restent sur cet appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si es posible, usa solo un nombre, iniciales o una etiqueta neutra. Los datos permanecen en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se possível, use apenas o primeiro nome, iniciais ou uma identificação neutra. Os dados permanecem neste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando possibile, usa solo un nome, le iniziali o un'etichetta neutra. I dati restano su questo dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По возможности используйте только имя, инициалы или нейтральное обозначение. Данные остаются на этом устройстве."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الاسم الأول أو الأحرف الأولى أو تسمية محايدة متى أمكن. تبقى البيانات على هذا الجهاز."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儘可能只使用名字、縮寫或中性稱呼。資料只會保留在這部裝置上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽可能只使用名字、缩写或中性称呼。数据只会保留在这台设备上。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשאפשר, השתמשו רק בשם פרטי, בראשי תיבות או בתווית ניטרלית. הנתונים נשארים במכשיר הזה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "可能であれば、名前、イニシャル、中立的な呼び名だけを使いましょう。データはこの端末に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가능하면 이름, 이니셜 또는 중립적인 호칭만 사용하세요. 데이터는 이 기기에 보관됩니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जहाँ संभव हो, केवल पहला नाम, शुरुआती अक्षर या तटस्थ नाम इस्तेमाल करें। डेटा इसी डिवाइस पर रहता है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За можливості використовуйте лише ім’я, ініціали або нейтральне позначення. Дані залишаються на цьому пристрої."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากทำได้ ให้ใช้เพียงชื่อจริง อักษรย่อ หรือคำเรียกที่เป็นกลาง ข้อมูลจะอยู่บนอุปกรณ์นี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu có thể, chỉ dùng tên, chữ viết tắt hoặc nhãn trung tính. Dữ liệu được giữ trên thiết bị này."
          }
        }
      }
    },
