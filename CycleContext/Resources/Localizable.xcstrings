    "cycleCorrection.optionalExplanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Wenn bessere Informationen zur aktuellen Phase vorliegen, kann die zeitliche Schätzung hier angepasst werden. Das erzeugt keinen bestätigten Periodenbeginn."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: If you have better information about the current phase, you can adjust the timing estimate here. This does not create a confirmed period start."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: If you have better information about the current phase, you can adjust the timing estimate here. This does not create a confirmed period start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : si vous disposez d’informations plus précises sur la phase actuelle, vous pouvez ajuster ici l’estimation des dates. Cela ne crée pas un début de règles confirmé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: si tienes información más precisa sobre la fase actual, puedes ajustar aquí la estimación de las fechas. Esto no crea un inicio de menstruación confirmado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: se você tiver informações melhores sobre a fase atual, poderá ajustar aqui a estimativa das datas. Isso não cria um início confirmado da menstruação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: se hai informazioni più precise sulla fase attuale, puoi modificare qui la stima dei tempi. Questo non crea un inizio delle mestruazioni confermato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно: если у вас есть более точные сведения о текущей фазе, скорректируйте здесь оценку сроков. Это не создаст подтверждённую дату начала менструации."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: إذا كانت لديك معلومات أدق عن المرحلة الحالية، يمكنك تعديل تقدير التوقيت هنا. لن يؤدي ذلك إلى إنشاء بداية مؤكدة للحيض."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填：如果你更清楚目前處於哪個階段，可以在此調整時間估計。這不會建立已確認的月經開始日。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：如果你更清楚目前处于哪个阶段，可以在此调整时间估计。这不会建立已确认的月经开始日。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אופציונלי: אם יש לכם מידע טוב יותר על השלב הנוכחי, אפשר לעדכן כאן את הערכת התזמון. פעולה זו אינה יוצרת התחלה מאושרת של הווסת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意：現在の時期についてより確かな情報があれば、ここで推定を調整できます。確認済みの月経開始日は作成されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: 현재 단계에 대해 더 확실한 정보가 있다면 여기서 시기 추정을 조정할 수 있습니다. 확인된 생리 시작일이 만들어지지는 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक: यदि वर्तमान चरण की बेहतर जानकारी है, तो यहाँ समय का अनुमान समायोजित करें। इससे माहवारी की पुष्टि की गई शुरुआत नहीं बनती।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язково: якщо ви краще знаєте поточну фазу, скоригуйте тут оцінку часу. Це не створює підтверджений початок менструації."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่บังคับ: หากคุณมีข้อมูลเกี่ยวกับระยะปัจจุบันที่ดีกว่า คุณสามารถปรับการประเมินช่วงเวลาได้ที่นี่ การปรับนี้จะไม่สร้างวันเริ่มมีประจำเดือนที่ยืนยันแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bắt buộc: Nếu bạn có thông tin chính xác hơn về giai đoạn hiện tại, bạn có thể điều chỉnh ước tính thời gian tại đây. Thao tác này không tạo ngày bắt đầu kỳ kinh đã xác nhận."
          }
        }
      }
    },
    "cycleCorrection.pmsExplanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die mögliche PMS-Zeit gehört biologisch zur Lutealphase und wird deshalb nicht als eigene Phase korrigiert."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The possible PMS period is biologically part of the luteal phase, so it is not corrected as a separate phase."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The possible PMS period is biologically part of the luteal phase, so it is not corrected as a separate phase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La période possible de SPM fait biologiquement partie de la phase lutéale ; elle n’est donc pas corrigée comme une phase distincte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El posible período de SPM forma parte biológicamente de la fase lútea, así que no se corrige como una fase independiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O possível período de TPM faz parte biologicamente da fase lútea, por isso não é corrigido como uma fase separada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il possibile periodo premestruale fa biologicamente parte della fase luteale, quindi non viene corretto come fase separata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С биологической точки зрения возможный период ПМС относится к лютеиновой фазе, поэтому его нельзя корректировать как отдельную фазу."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعد فترة ما قبل الحيض المحتملة جزءًا من الطور الأصفري بيولوجيًا، لذا لا تُعدل بوصفها مرحلة منفصلة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能的經前症候群時期在生理上屬於黃體期，因此不會當作獨立階段調整。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能出现经前症状的时期在生理上属于黄体期，因此不会当作独立阶段调整。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקופה האפשרית של תסמיני PMS היא חלק ביולוגי מהשלב הלוטאלי, ולכן לא מתקנים אותה כשלב נפרד."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS症状が起こり得る時期は生物学的には黄体期の一部なので、独立した時期として修正しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PMS 증상이 나타날 수 있는 시기는 생물학적으로 황체기에 속하므로 별도 단계로 수정하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संभावित PMS समय जैविक रूप से ल्यूटियल चरण का हिस्सा है, इसलिए इसे अलग चरण के रूप में ठीक नहीं किया जाता।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можливий період ПМС біологічно належить до лютеїнової фази, тому його не коригують як окрему фазу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงที่อาจมี PMS เป็นส่วนหนึ่งของระยะลูเทียลในทางชีววิทยา จึงไม่สามารถปรับเป็นระยะแยกต่างหาก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian có thể có PMS thuộc giai đoạn hoàng thể về mặt sinh học, vì vậy không được điều chỉnh như một giai đoạn riêng."
          }
        }
      }
    },
