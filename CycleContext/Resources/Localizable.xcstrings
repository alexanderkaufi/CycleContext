    "periodStart.exampleTimingHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis ein echter Beginn eingetragen wird, bleibt die zeitliche Darstellung eine Beispielrechnung."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Until an actual start is entered, the timing remains an example calculation."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Until an actual start is entered, the timing remains an example calculation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant qu’un début réel n’est pas saisi, les dates restent un exemple de calcul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que se introduzca un inicio real, las fechas serán solo un cálculo de ejemplo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que um início real seja informado, as datas serão apenas um exemplo de cálculo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché non viene inserito un inizio effettivo, i tempi restano un calcolo di esempio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока фактическая дата начала не указана, расчёт сроков остаётся примерным."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى التوقيت حسابًا توضيحيًا حتى إدخال بداية فعلية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在輸入實際開始日前，時間顯示仍是示範推算。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在输入实际开始日前，时间显示仍是示例推算。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד להזנת התחלה אמיתית, התזמון נשאר חישוב לדוגמה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の開始日を入力するまでは、時期は例としての計算です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 시작일을 입력하기 전까지 시기는 예시 계산입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वास्तविक शुरुआत दर्ज होने तक समय केवल उदाहरण गणना रहेगा।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки фактичний початок не введено, час лишається прикладом розрахунку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จนกว่าจะป้อนวันเริ่มจริง การแสดงช่วงเวลาจะยังเป็นตัวอย่างการคำนวณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho đến khi nhập ngày bắt đầu thực tế, thời gian vẫn là tính toán mẫu."
          }
        }
      }
    },
    "periodStart.explanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeint ist der erste Tag der letzten tatsächlich bekannten normalen Periode. Ein Befindenseintrag mit Blutung bestätigt den Zyklusbeginn nicht automatisch."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the first day of the last known normal period. A wellbeing entry that includes bleeding does not automatically confirm a cycle start."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the first day of the last known normal period. A wellbeing entry that includes bleeding does not automatically confirm a cycle start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le premier jour des dernières règles normales connues. Une entrée de bien-être comprenant des saignements ne confirme pas automatiquement le début d’un cycle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el primer día de la última menstruación normal conocida. Una entrada de bienestar que incluya sangrado no confirma automáticamente el inicio de un ciclo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o primeiro dia da última menstruação normal conhecida. Um registro de bem-estar que inclua sangramento não confirma automaticamente o início de um ciclo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il primo giorno delle ultime mestruazioni normali conosciute. Una voce sul benessere che include sanguinamento non conferma automaticamente l'inizio di un ciclo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите первый день последней известной обычной менструации. Запись о самочувствии с указанием кровотечения не подтверждает автоматически начало цикла."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم اليوم الأول من آخر حيض طبيعي معروف. ولا تؤكد ملاحظة الحالة التي تتضمن نزفًا بداية دورة تلقائيًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用最近一次已知的正常月經第一天。含有出血資訊的身體感受紀錄，不會自動確認週期開始。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用最近一次已知的正常月经第一天。含有出血信息的身体感受记录，不会自动确认周期开始。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו ביום הראשון של הווסת הרגילה האחרונה הידועה. רשומת הרגשה שכוללת דימום אינה מאשרת אוטומטית תחילת מחזור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に分かっている通常の月経の初日を入力してください。出血を含む体調記録だけでは、周期の開始日は自動的に確定しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 알고 있는 평소 생리의 첫날을 입력하세요. 출혈이 포함된 컨디션 기록만으로 주기 시작일이 자동 확인되지는 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आखिरी ज्ञात सामान्य माहवारी का पहला दिन इस्तेमाल करें। रक्तस्राव वाला स्वास्थ्य रिकॉर्ड अपने आप चक्र की शुरुआत की पुष्टि नहीं करता।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використайте перший день останньої відомої звичайної менструації. Запис про самопочуття з кровотечею не підтверджує початок циклу автоматично."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้วันแรกของประจำเดือนตามปกติครั้งล่าสุดที่ทราบ บันทึกความรู้สึกที่ระบุว่ามีเลือดออกจะไม่ยืนยันวันเริ่มรอบเดือนโดยอัตโนมัติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng ngày đầu tiên của kỳ kinh bình thường gần nhất mà bạn biết. Một ghi chép cảm nhận có chảy máu không tự động xác nhận ngày bắt đầu chu kỳ."
          }
        }
      }
    },
