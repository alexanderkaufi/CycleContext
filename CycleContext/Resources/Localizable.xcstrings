            "value": "Os dados do ciclo e os registros dessa pessoa serão removidos deste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati del ciclo e le voci di questa persona saranno rimossi dal dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные цикла и записи этого человека будут удалены с устройства."
