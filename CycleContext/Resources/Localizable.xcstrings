        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعتمد ملاءمة الأقسام الخمسة على وسيلة منع الحمل المستخدمة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這五個階段是否適用，取決於使用的避孕方法。"
