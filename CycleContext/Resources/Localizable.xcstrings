    "profile.standardValues.explanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "28 Zyklustage und 5 Blutungstage sind allgemeine Modellannahmen. Sie machen die App sofort erlebbar, ersetzen aber keine persönliche Beobachtung."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A 28-day cycle and 5 bleeding days are general model assumptions. They make the app immediately usable but do not replace personal observation."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A 28-day cycle and 5 bleeding days are general model assumptions. They make the app immediately usable but do not replace personal observation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cycle de 28 jours et 5 jours de saignement sont des hypothèses générales du modèle. Elles rendent l’app immédiatement utilisable, mais ne remplacent pas l’observation personnelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ciclo de 28 días y 5 días de sangrado son suposiciones generales del modelo. Permiten usar la app de inmediato, pero no sustituyen la observación personal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ciclo de 28 dias e 5 dias de sangramento são suposições gerais do modelo. Elas permitem usar o app imediatamente, mas não substituem a observação pessoal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ciclo di 28 giorni e 5 giorni di flusso sono ipotesi generali del modello. Rendono l'app subito utilizzabile, ma non sostituiscono l'osservazione personale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цикл в 28 дней и кровотечение в 5 дней — общие допущения модели. Они позволяют сразу пользоваться приложением, но не заменяют личные наблюдения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دورة مدتها 28 يومًا ونزف مدته 5 أيام هما افتراضان عامان للنموذج. يجعلان التطبيق قابلًا للاستخدام فورًا، لكنهما لا يغنيان عن الملاحظة الشخصية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "28 天週期和 5 天出血是一般模型的假設。它們讓 App 可以立即使用，但不能取代個人觀察。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "28 天周期和 5 天出血是一般模型的假设。它们让 App 可以立即使用，但不能取代个人观察。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחזור של 28 ימים ודימום של 5 ימים הם הנחות כלליות של המודל. הם מאפשרים להשתמש באפליקציה מיד, אך אינם מחליפים תצפית אישית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周期28日と出血5日は、一般的なモデルの初期値です。すぐにアプリを使えるようにするためのもので、本人の観察に代わるものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주기 28일과 출혈 5일은 일반적인 모델의 기본값입니다. 앱을 바로 사용할 수 있게 하지만 개인의 관찰을 대신하지는 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "28 दिन का चक्र और 5 दिन का रक्तस्राव सामान्य मॉडल की धारणाएँ हैं। उनसे ऐप तुरंत उपयोगी बनता है, लेकिन वे व्यक्तिगत अवलोकन का विकल्प नहीं हैं।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цикл 28 днів і 5 днів кровотечі — загальні припущення моделі. Вони дають змогу відразу користуватися програмою, але не замінюють особистих спостережень."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รอบเดือน 28 วันและมีเลือดออก 5 วันเป็นสมมติฐานทั่วไปของแบบจำลอง ช่วยให้ใช้แอปได้ทันที แต่ไม่ใช้แทนการสังเกตส่วนบุคคล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chu kỳ 28 ngày và 5 ngày chảy máu là các giả định mô hình chung. Chúng giúp ứng dụng có thể sử dụng ngay nhưng không thay thế quan sát cá nhân."
          }
        }
      }
    },
