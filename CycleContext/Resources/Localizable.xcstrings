    "cycle.content.building.avoidText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Kalender eine Erwartung machen oder Energie und gute Laune voraussetzen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not turn the calendar into an expectation or assume energy and a good mood."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not turn the calendar into an expectation or assume energy and a good mood."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne faites pas du calendrier une attente et ne présumez pas d’un regain d’énergie ou de bonne humeur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No conviertas el calendario en una expectativa ni des por hecho que tendrá energía y buen ánimo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não transforme o calendário em uma expectativa nem presuma que ela terá mais energia ou bom humor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non trasformare il calendario in un'aspettativa di energia o buonumore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не превращайте календарь в ожидание прилива сил или хорошего настроения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحول التقويم إلى توقع مسبق للطاقة أو المزاج الجيد."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把日曆當成對她的期待，也不要認定她一定精力充沛、心情愉快。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把日历当成对她的期待，也不要认定她一定精力充沛、心情愉快。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא להפוך את לוח השנה לציפייה ממנה, ולא להניח שבהכרח יש יותר אנרגיה או מצב רוח טוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの表示を期待の押し付けに変えたり、必ず元気で機嫌がよいと決めつけたりしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력의 표시를 상대에 대한 기대로 바꾸거나 반드시 활력이 넘치고 기분이 좋을 것이라고 단정하지 마세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलेंडर को अपेक्षा न बनाएँ और ऊर्जा या अच्छे मूड का अनुमान न लगाएँ।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не перетворюйте календар на очікування й не припускайте високої енергії чи гарного настрою."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าใช้ปฏิทินเป็นข้อคาดหวัง หรือสรุปว่าจะต้องมีพลังงานและอารมณ์ดี"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng biến lịch thành kỳ vọng hoặc mặc định rằng người ấy sẽ tràn đầy năng lượng và vui vẻ."
          }
        }
      }
    },
