    "cycle.content.luteal.todayText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Eisprung stellt sich der Körper hormonell um. Bedürfnisse können stabil bleiben oder sich verändern."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "After ovulation, the body adjusts hormonally. Needs may remain stable or begin to change."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "After ovulation, the body adjusts hormonally. Needs may remain stable or begin to change."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’ovulation, le corps s’adapte sur le plan hormonal. Les besoins peuvent rester stables ou commencer à changer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la ovulación, el cuerpo se adapta hormonalmente. Las necesidades pueden mantenerse estables o empezar a cambiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois da ovulação, o corpo passa por ajustes hormonais. As necessidades podem permanecer estáveis ou começar a mudar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo l'ovulazione, il corpo cambia assetto ormonale. Le esigenze possono restare stabili o iniziare a cambiare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После овуляции меняется гормональный фон. Потребности могут оставаться прежними или начать меняться."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الإباضة، يتكيف الجسم هرمونيًا. قد تبقى الاحتياجات كما هي أو تبدأ بالتغير."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵後，身體的荷爾蒙狀態會調整。需求可能維持不變，也可能開始變化。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵后，身体的激素状态会调整。需求可能维持不变，也可能开始变化。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר הביוץ הגוף עובר שינוי הורמונלי. הצרכים עשויים להישאר יציבים או להתחיל להשתנות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵後、体内のホルモン環境が変化します。必要なことは変わらない場合も、変わり始める場合もあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배란 뒤 몸의 호르몬 환경이 달라집니다. 필요한 것은 그대로일 수도, 달라지기 시작할 수도 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंडोत्सर्जन के बाद शरीर हार्मोन के अनुसार ढलता है। ज़रूरतें स्थिर रह सकती हैं या बदलना शुरू हो सकती हैं।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після овуляції організм гормонально перебудовується. Потреби можуть залишатися стабільними або почати змінюватися."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังตกไข่ ร่างกายจะปรับตัวด้านฮอร์โมน ความต้องการอาจคงเดิมหรือเริ่มเปลี่ยนแปลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi rụng trứng, cơ thể điều chỉnh về hormone. Nhu cầu có thể ổn định hoặc bắt đầu thay đổi."
          }
        }
      }
    },
    "cycle.content.menstruation.avoidText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schmerz kleinreden, ungefragt behandeln oder grundsätzlich von Bewegung abraten."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not minimise pain, treat it without being asked, or generally advise against movement."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not minimize pain, treat it without being asked, or generally advise against movement."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne minimisez pas la douleur, ne la traitez pas sans qu’on vous le demande et ne déconseillez pas systématiquement de bouger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No minimices el dolor, no intentes tratarlo sin que te lo pidan ni desaconsejes el movimiento por regla general."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não minimize a dor, não tente tratá-la sem que ela peça e não desaconselhe todo tipo de movimento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non minimizzare il dolore, non cercare di curarlo senza che sia richiesto e non sconsigliare in generale il movimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не преуменьшайте боль, не пытайтесь лечить её без просьбы и не советуйте в целом избегать движения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تقلل من شأن الألم، ولا تحاول علاجه من دون طلب، ولا تنصح بتجنب الحركة على نحو مطلق."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要輕忽疼痛、未經詢問就替她處理，也不要一概勸她避免活動。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要轻忽疼痛、未经询问就替她处理，也不要一概劝她避免活动。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא להמעיט בערך הכאב, לא לטפל בו בלי שהתבקשתם, ולא להמליץ באופן גורף להימנע מתנועה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "痛みを軽く見たり、頼まれていないのに対処法を押し付けたり、運動を一律に避けるよう勧めたりしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통증을 가볍게 여기거나 요청받지 않은 해결책을 강요하거나 움직이지 말라고 일률적으로 권하지 마세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्द को कम न आँकें, बिना पूछे उसका इलाज न करें और सामान्य रूप से गतिविधि से बचने की सलाह न दें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не применшуйте біль, не лікуйте його без прохання й не радьте загалом уникати руху."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่ามองข้ามความเจ็บปวด รักษาโดยอีกฝ่ายไม่ได้ขอ หรือแนะนำให้งดเคลื่อนไหวไปทั้งหมด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng xem nhẹ cơn đau, tự ý điều trị hoặc khuyên tránh vận động hoàn toàn."
          }
        }
      }
    },
