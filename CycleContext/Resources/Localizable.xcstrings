    "cycle.content.building.todayText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Blutung können Beschwerden nachlassen und neue Energie kann entstehen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "As bleeding ends, symptoms may ease and new energy may emerge."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "As bleeding ends, symptoms may ease and new energy may emerge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand les saignements prennent fin, les symptômes peuvent s’atténuer et l’énergie revenir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al terminar el sangrado, los síntomas pueden aliviarse y puede aparecer más energía."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o sangramento termina, os sintomas podem diminuir e a energia pode voltar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la fine delle mestruazioni, i sintomi possono attenuarsi e può tornare energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С окончанием кровотечения симптомы могут ослабнуть и сил может стать больше."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع انتهاء النزف، قد تخف الأعراض وتعود بعض الطاقة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨著出血結束，症狀可能減輕，也可能逐漸恢復精神。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随着出血结束，症状可能减轻，也可能逐渐恢复精神。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם סיום הדימום, התסמינים עשויים להיחלש ואולי תורגש יותר אנרגיה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出血が終わるころには症状が和らぎ、元気が戻ることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출혈이 끝나 가면서 증상이 가라앉고 기운이 돌아올 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रक्तस्राव समाप्त होने पर लक्षण कम हो सकते हैं और नई ऊर्जा महसूस हो सकती है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після завершення кровотечі симптоми можуть слабшати, а енергія — зростати."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเลือดประจำเดือนหยุด อาการต่าง ๆ อาจลดลงและพลังงานอาจกลับมา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi hết chảy máu, các triệu chứng có thể giảm và năng lượng mới có thể xuất hiện."
          }
        }
      }
    },
    "cycle.content.luteal.avoidText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Meinung oder Emotion mit dem Satz 'Das sind nur die Hormone' abwerten."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not dismiss an opinion or emotion by saying, 'It is just the hormones.'"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not dismiss an opinion or emotion by saying, 'It is just the hormones.'"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne balayez pas une opinion ou une émotion en disant : « Ce sont juste les hormones. »"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No descartes una opinión o emoción diciendo: «Son solo las hormonas»."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não descarte uma opinião ou emoção dizendo: “São só os hormônios”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non liquidare un'opinione o un'emozione dicendo: «Sono solo gli ormoni»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не обесценивайте мнение или эмоцию словами «Это просто гормоны»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستخف برأي أو شعور بالقول: «هذه مجرد هرمونات»."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要用「這只是荷爾蒙作祟」來否定她的意見或情緒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要用「这只是激素作祟」来否定她的意见或情绪。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא לבטל דעה או רגש באמירה ״אלה רק ההורמונים״."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "意見や感情を「ホルモンのせい」と片付けないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의견이나 감정을 “그냥 호르몬 때문이야”라며 무시하지 마세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी राय या भावना को “यह सिर्फ़ हार्मोन है” कहकर न टालें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не відкидайте думку чи емоцію словами «це лише гормони»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าลดทอนความคิดเห็นหรืออารมณ์ด้วยคำว่า “ก็แค่ฮอร์โมน”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng xem nhẹ ý kiến hoặc cảm xúc bằng câu “Chỉ là hormone thôi”."
          }
        }
      }
    },
