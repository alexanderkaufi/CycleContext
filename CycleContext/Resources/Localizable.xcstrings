    "cycle.content.ovulation_window.medicalNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geschätzte Fenster ist keine sichere Verhütungs- oder Fruchtbarkeitsbestimmung."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimated window is not a reliable method of contraception or fertility determination."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The estimated window is not a reliable method of contraception or fertility determination."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La période estimée n’est pas une méthode fiable de contraception ou de détermination des jours fertiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana estimada no es un método fiable de anticoncepción ni de identificación de los días fértiles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela estimada não é um método confiável de contracepção nem de identificação dos dias férteis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra stimata non è un metodo affidabile né per la contraccezione né per individuare i giorni fertili."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предполагаемый период овуляции не является надёжным способом контрацепции или определения фертильных дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فترة الإباضة المقدرة ليست وسيلة موثوقة لمنع الحمل أو تحديد أيام الخصوبة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預估的排卵時段不能可靠地用於避孕或判定受孕能力。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预估的排卵时段不能可靠地用于避孕或判定受孕能力。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלון הביוץ המשוער אינו שיטה אמינה למניעת היריון או לקביעת פוריות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定された時期は、避妊や妊娠しやすい日の判定に使える確実な方法ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정된 배란 시기는 피임이나 가임기 판단에 사용할 수 있는 신뢰할 만한 방법이 아닙니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमानित अवधि गर्भनिरोध या प्रजनन क्षमता जानने का भरोसेमंद तरीका नहीं है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Орієнтовне вікно не є надійним методом контрацепції чи визначення фертильності."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาที่ประเมินไม่ใช่วิธีคุมกำเนิดหรือระบุภาวะเจริญพันธุ์ที่เชื่อถือได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng thời gian ước tính không phải phương pháp tránh thai hoặc xác định khả năng sinh sản đáng tin cậy."
          }
        }
      }
    },
    "cycle.content.ovulation_window.partnerActionText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein höheres Energie- oder Aktivitätsniveau kann für gemeinsame Unternehmungen genutzt werden, wenn es dem tatsächlichen Befinden entspricht. Nähe und Sexualität sollten nie aus einem vermuteten Eisprung erwartet werden. Wünsche und Grenzen werden direkt besprochen – nicht aus einer App oder einem Kalendertag abgeleitet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher level of energy or activity can be used for shared plans if it matches how she actually feels. Closeness and sex should never be expected because ovulation is assumed. Wishes and boundaries should be discussed directly, not inferred from an app or a calendar day."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher level of energy or activity can be used for shared plans if it matches how she actually feels. Closeness and sex should never be expected because ovulation is assumed. Wishes and boundaries should be discussed directly, not inferred from an app or a calendar day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un niveau d’énergie ou d’activité plus élevé peut être mis à profit pour des projets communs si cela correspond à ce qu’elle ressent réellement. Il ne faut jamais s’attendre à de la proximité ou à des rapports sexuels parce qu’une ovulation est supposée. Parlez directement des envies et des limites, sans les déduire d’une app ou d’un jour du calendrier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nivel de energía o actividad más alto puede aprovecharse para hacer planes juntos si coincide con cómo se siente realmente. Nunca se debe esperar cercanía o sexo porque se supone que está ovulando. Habla directamente con ella de sus deseos y límites; no los deduzcas de una app ni de un día del calendario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma energia ou disposição maior pode ser aproveitada para planos em conjunto se isso corresponder ao que ela realmente sente. Nunca se deve esperar proximidade ou sexo porque se presume que ela esteja ovulando. Converse diretamente sobre desejos e limites; não os deduza de um app ou de um dia do calendário."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'eventuale maggiore energia può essere sfruttata per programmi condivisi, se corrisponde a come si sente davvero. Non aspettarti vicinanza o sesso perché si presume che sia in ovulazione. Desideri e limiti vanno discussi direttamente, non dedotti da un'app o da un giorno sul calendario."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если энергии стало больше, можно строить совместные планы, когда это соответствует её реальному самочувствию. Не следует ожидать близости или секса лишь из-за предполагаемой овуляции. Желания и границы нужно обсуждать напрямую, а не выводить из приложения или дня календаря."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا توفرت طاقة أكبر وكانت متوافقة مع شعورها الفعلي، يمكن استغلالها في خطط مشتركة. لا تتوقع القرب أو الجنس لمجرد افتراض حدوث الإباضة. ناقش الرغبات والحدود مباشرةً، ولا تستنتجها من تطبيق أو يوم في التقويم."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果她實際感覺精力較充沛，可以安排共同活動。但不要因推測她正在排卵，就期待親密接觸或性行為。想法與界線應直接溝通，而不是從 App 或日曆日期推斷。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果她实际感觉精力较充沛，可以安排共同活动。但不要因推测她正在排卵，就期待亲密接触或性行为。想法与界线应直接沟通，而不是从 App 或日历日期推断。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם יש יותר אנרגיה והיא אכן מרגישה כך, אפשר לתכנן דברים משותפים. אין לצפות לקרבה או למין רק מפני שמשערים שהיה ביוץ. על רצונות וגבולות כדאי לדבר ישירות, ולא להסיק אותם מהאפליקציה או מיום בלוח השנה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人が実際に元気だと感じていれば、一緒の予定を立てるのもよいでしょう。ただし、排卵が推定されるからといって、親密さや性行為を期待してはいけません。希望や境界線は、アプリやカレンダーの日付から推測せず、本人と直接話し合ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 활력이 높다고 느낀다면 함께할 계획을 세울 수 있습니다. 하지만 배란이 예상된다는 이유로 친밀감이나 성관계를 기대해서는 안 됩니다. 바람과 경계는 앱이나 달력 날짜로 추측하지 말고 직접 이야기하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि वास्तविक स्थिति के अनुकूल हो, तो अधिक ऊर्जा या गतिविधि को साझा योजनाओं में इस्तेमाल किया जा सकता है। अनुमानित अंडोत्सर्जन के कारण निकटता या सेक्स की कभी अपेक्षा नहीं करनी चाहिए। इच्छाओं और सीमाओं पर सीधे बात करें; ऐप या कैलेंडर के दिन से निष्कर्ष न निकालें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вищий рівень енергії чи активності можна використати для спільних планів, якщо це відповідає фактичному самопочуттю. Не можна очікувати близькості чи сексу лише через припущення про овуляцію. Бажання й межі слід обговорювати прямо, а не виводити з програми чи дня календаря."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากระดับพลังงานหรือกิจกรรมสูงขึ้นและตรงกับความรู้สึกจริงของบุคคลนั้น ก็อาจใช้ช่วงนี้วางแผนร่วมกันได้ ไม่ควรคาดหวังความใกล้ชิดหรือเพศเพียงเพราะคาดว่าอยู่ในช่วงตกไข่ ควรพูดคุยเรื่องความต้องการและขอบเขตโดยตรง ไม่ใช่สรุปจากแอปหรือวันในปฏิทิน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức năng lượng hoặc hoạt động cao hơn có thể được tận dụng cho kế hoạch chung nếu phù hợp với cảm nhận thực tế của người ấy. Không bao giờ nên kỳ vọng sự gần gũi hoặc tình dục chỉ vì cho rằng đang rụng trứng. Mong muốn và ranh giới cần được trao đổi trực tiếp, không phải suy ra từ ứng dụng hoặc một ngày trên lịch."
          }
        }
      }
    },
    "cycle.content.ovulation_window.possibleExperienceText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Frauen berichten rund um den Eisprung von mehr Energie, Selbstvertrauen, Kontaktfreude oder sexuellem Interesse. Besonders das sexuelle Verlangen kann sich verändern, folgt aber keinem festen Muster. Andere bemerken weder körperlich noch psychisch einen Unterschied.\n\nAus dem Eisprung lassen sich keine verlässlichen Aussagen über Stimmung, Attraktivität, Entscheidungsfähigkeit oder Leistungsvermögen ableiten. Solche Eigenschaften entstehen aus vielen Einflüssen: Persönlichkeit, Beziehung, Stress, Schlaf und die jeweilige Situation gehören ebenso dazu. Beobachtete Veränderungen sollten daher nicht automatisch den Hormonen zugeschrieben werden."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Some women report more energy, confidence, sociability, or sexual interest around ovulation. Sexual desire in particular may change, but it does not follow a fixed pattern. Others notice no physical or emotional difference.\n\nOvulation does not allow reliable conclusions about mood, attractiveness, decision-making, or performance. These qualities are shaped by many influences, including personality, relationships, stress, sleep, and the situation itself. Observed changes should therefore not automatically be attributed to hormones."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Some women report more energy, confidence, sociability, or sexual interest around ovulation. Sexual desire in particular may change, but it does not follow a fixed pattern. Others notice no physical or emotional difference.\n\nOvulation does not allow reliable conclusions about mood, attractiveness, decision-making, or performance. These qualities are shaped by many influences, including personality, relationships, stress, sleep, and the situation itself. Observed changes should therefore not automatically be attributed to hormones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines femmes disent ressentir davantage d’énergie, de confiance, d’envie de voir du monde ou de désir sexuel autour de l’ovulation. Le désir sexuel, en particulier, peut varier, mais ne suit pas de schéma fixe. D’autres ne remarquent aucune différence physique ou émotionnelle.\n\nL’ovulation ne permet pas de tirer des conclusions fiables sur l’humeur, l’attirance, la prise de décision ou les performances. Ces caractéristiques dépendent de nombreux facteurs, dont la personnalité, les relations, le stress, le sommeil et la situation elle-même. Les changements observés ne doivent donc pas être automatiquement attribués aux hormones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas mujeres dicen sentir más energía, confianza, ganas de relacionarse o interés sexual alrededor de la ovulación. El deseo sexual, en particular, puede variar, pero no sigue un patrón fijo. Otras no notan ninguna diferencia física ni emocional.\n\nLa ovulación no permite sacar conclusiones fiables sobre el ánimo, el atractivo, la capacidad de decisión o el rendimiento. Estas cualidades dependen de muchos factores, entre ellos la personalidad, las relaciones, el estrés, el sueño y la situación concreta. Por eso, los cambios observados no deben atribuirse automáticamente a las hormonas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas mulheres relatam mais energia, confiança, vontade de socializar ou interesse sexual perto da ovulação. O desejo sexual, em particular, pode mudar, mas não segue um padrão fixo. Outras não percebem nenhuma diferença física ou emocional.\n\nA ovulação não permite conclusões confiáveis sobre humor, atratividade, capacidade de tomar decisões ou desempenho. Essas características são moldadas por muitos fatores, incluindo personalidade, relacionamentos, estresse, sono e a própria situação. Portanto, mudanças observadas não devem ser atribuídas automaticamente aos hormônios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune donne riferiscono più energia, sicurezza, socievolezza o interesse sessuale intorno all'ovulazione. Il desiderio sessuale, in particolare, può cambiare, ma non segue uno schema fisso. Altre non notano differenze fisiche o emotive.\n\nL'ovulazione non consente conclusioni affidabili su umore, attrattiva, capacità decisionali o prestazioni. Questi aspetti dipendono da molti fattori, tra cui personalità, relazioni, stress, sonno e situazione concreta. I cambiamenti osservati non vanno quindi attribuiti automaticamente agli ormoni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые женщины вблизи овуляции отмечают больше энергии, уверенности, общительности или сексуального интереса. В частности, желание может меняться, но не следует постоянному шаблону. Другие не ощущают ни физических, ни эмоциональных изменений.\n\nПо овуляции нельзя надёжно судить о настроении, привлекательности, решениях или работоспособности. На всё это влияет множество факторов: личность, отношения, стресс, сон и сама ситуация. Поэтому наблюдаемые изменения не следует автоматически приписывать гормонам."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكر بعض النساء زيادة في الطاقة أو الثقة أو الرغبة في التواصل أو الاهتمام الجنسي قرب الإباضة. وقد تتغير الرغبة الجنسية خصوصًا، لكنها لا تتبع نمطًا ثابتًا. ولا تلاحظ أخريات أي اختلاف بدني أو عاطفي.\n\nلا تتيح الإباضة استنتاجات موثوقة عن المزاج أو الجاذبية أو اتخاذ القرارات أو الأداء. تتأثر هذه الجوانب بعوامل عديدة، منها الشخصية والعلاقات والضغط والنوم والموقف نفسه. لذلك لا ينبغي أن تُنسب التغيرات الملحوظة تلقائيًا إلى الهرمونات."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些女性表示排卵前後精力、自信、社交意願或性興趣增加。尤其性慾可能改變，但沒有固定模式；也有人完全沒有察覺身體或情緒上的差異。\n\n排卵並不能可靠地推論心情、吸引力、決策能力或表現。這些面向受到性格、關係、壓力、睡眠及當下情境等許多因素影響。因此，不應自動把觀察到的變化歸因於荷爾蒙。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些女性表示排卵前后精力、自信、社交意愿或性兴趣增加。尤其性欲可能改变，但没有固定模式；也有人完全没有察觉身体或情绪上的差异。\n\n排卵并不能可靠地推论心情、吸引力、决策能力或表现。这些面向受到性格、关系、压力、睡眠及当下情境等许多因素影响。因此，不应自动把观察到的变化归因于激素。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש נשים שמדווחות על יותר אנרגיה, ביטחון עצמי, רצון למפגש חברתי או עניין מיני סביב הביוץ. החשק המיני בפרט עשוי להשתנות, אך אינו פועל לפי דפוס קבוע. אחרות אינן מבחינות בשינוי גופני או רגשי.\n\nביוץ אינו מאפשר להסיק באופן אמין על מצב רוח, משיכה, קבלת החלטות או ביצועים. גורמים רבים משפיעים על אלה, ובהם אישיות, יחסים, לחץ, שינה והמצב עצמו. לכן אין לייחס אוטומטית שינויים שנצפו להורמונים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵の前後に、元気、自信、人づきあいへの意欲、性的関心が高まると感じる人もいます。特に性欲は変化することがありますが、決まったパターンはありません。身体面でも感情面でも変化に気づかない人もいます。\n\n排卵から気分、魅力、判断力、能力を確実に推測することはできません。性格、人間関係、ストレス、睡眠、その場の状況など、多くの要素が影響します。見られた変化を自動的にホルモンのせいにしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배란 전후에 활력, 자신감, 사교성, 성적 관심이 높아진다고 느끼는 사람도 있습니다. 특히 성욕은 달라질 수 있지만 정해진 양상은 없습니다. 몸이나 마음의 차이를 전혀 느끼지 못하는 사람도 있습니다.\n\n배란만으로 기분, 매력, 판단력, 능력을 정확히 알 수는 없습니다. 성격, 관계, 스트레스, 수면, 당시 상황 등 여러 요인이 영향을 줍니다. 관찰된 변화를 자동으로 호르몬 때문이라고 생각하지 마세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ लोग अंडोत्सर्जन के आसपास अधिक ऊर्जा, आत्मविश्वास, मिलनसारिता या यौन रुचि बताते हैं। खासकर यौन इच्छा बदल सकती है, लेकिन यह किसी तय ढर्रे पर नहीं चलती। अन्य लोगों को कोई शारीरिक या भावनात्मक अंतर नहीं दिखता।\n\nअंडोत्सर्जन से मूड, आकर्षण, निर्णय लेने की क्षमता या प्रदर्शन का भरोसेमंद निष्कर्ष नहीं निकाला जा सकता। इन गुणों पर व्यक्तित्व, संबंध, तनाव, नींद और परिस्थिति समेत कई प्रभाव पड़ते हैं। इसलिए देखे गए बदलावों को अपने आप हार्मोन से नहीं जोड़ना चाहिए।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дехто повідомляє про більше енергії, упевненості, товариськості або сексуального інтересу навколо овуляції. Сексуальне бажання може змінюватися, але не має фіксованого шаблону. Інші не помічають фізичної чи емоційної різниці.\n\nОвуляція не дає змоги надійно судити про настрій, привабливість, рішення чи працездатність. На ці якості впливають особистість, стосунки, стрес, сон і сама ситуація. Тому помічені зміни не слід автоматично пояснювати гормонами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บางคนรายงานว่ามีพลังงาน ความมั่นใจ ความต้องการเข้าสังคม หรือความสนใจทางเพศมากขึ้นในช่วงตกไข่ โดยเฉพาะความต้องการทางเพศอาจเปลี่ยนแปลงได้ แต่ไม่ได้เป็นไปตามรูปแบบตายตัว ขณะที่บางคนไม่รู้สึกถึงความแตกต่างทางกายหรืออารมณ์เลย\n\nการตกไข่ไม่ได้ทำให้เราสรุปเรื่องอารมณ์ ความน่าดึงดูด การตัดสินใจ หรือสมรรถนะได้อย่างน่าเชื่อถือ คุณลักษณะเหล่านี้ได้รับอิทธิพลจากหลายปัจจัย รวมถึงบุคลิก ความสัมพันธ์ ความเครียด การนอน และสถานการณ์ จึงไม่ควรโยงการเปลี่ยนแปลงที่สังเกตเห็นเข้ากับฮอร์โมนโดยอัตโนมัติ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số người cho biết họ có nhiều năng lượng, tự tin, hứng thú giao tiếp hoặc ham muốn tình dục hơn quanh thời điểm rụng trứng. Ham muốn tình dục nói riêng có thể thay đổi, nhưng không theo một khuôn mẫu cố định. Những người khác không nhận thấy khác biệt về thể chất hoặc cảm xúc.\n\nRụng trứng không cho phép kết luận đáng tin cậy về tâm trạng, sức hấp dẫn, khả năng ra quyết định hoặc hiệu suất. Những đặc điểm này chịu ảnh hưởng của nhiều yếu tố, gồm tính cách, mối quan hệ, căng thẳng, giấc ngủ và hoàn cảnh. Vì vậy, không nên tự động quy những thay đổi quan sát được cho hormone."
          }
        }
      }
    },
    "cycle.content.ovulation_window.shortGuide": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Eisprung wird eine Eizelle freigesetzt. Der genaue Zeitpunkt kann sich verschieben und bleibt eine Schätzung; Nähe, sexuelles Interesse oder Aktivitätsniveau folgen keinem festen Muster."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "An egg is released around ovulation. The exact timing can shift and remains an estimate; closeness, sexual interest, and activity levels do not follow a fixed pattern."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "An egg is released around ovulation. The exact timing can shift and remains an estimate; closeness, sexual interest, and activity levels do not follow a fixed pattern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ovocyte est libéré lors de l’ovulation. Le moment exact peut varier et reste une estimation ; la proximité, le désir sexuel et le niveau d’activité ne suivent pas de schéma fixe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alrededor de la ovulación se libera un óvulo. El momento exacto puede cambiar y sigue siendo una estimación; la cercanía, el interés sexual y la actividad no siguen un patrón fijo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um óvulo é liberado perto da ovulação. O momento exato pode mudar e continua sendo uma estimativa; proximidade, interesse sexual e nível de atividade não seguem um padrão fixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intorno all'ovulazione viene rilasciato un ovulo. Il momento esatto può variare ed è solo stimato; vicinanza, interesse sessuale e attività non seguono uno schema fisso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вблизи овуляции выходит яйцеклетка. Точное время может сдвигаться и остаётся оценкой; желание близости, сексуальный интерес и активность не следуют жёсткому шаблону."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحرر بويضة قرب موعد الإباضة. وقد يتغير التوقيت الدقيق، لذا يبقى تقديريًا؛ ولا تتبع الرغبة في القرب أو الجنس أو مستوى النشاط نمطًا ثابتًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵前後會釋出卵子。確切時間可能變動，仍屬估計；親密需求、性興趣與活動量也沒有固定模式。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵前后会释放卵子。确切时间可能变动，仍属估计；亲密需求、性兴趣与活动量也没有固定模式。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סביב הביוץ משתחררת ביצית. התזמון המדויק עשוי להשתנות ונשאר בגדר הערכה; קרבה, עניין מיני ורמת הפעילות אינם פועלים לפי דפוס קבוע."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "排卵のころに卵子が放出されます。正確な時期はずれる可能性があり、あくまで推定です。親密さ、性的関心、活動量に決まったパターンはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배란 무렵 난자가 나옵니다. 정확한 시점은 달라질 수 있으며 추정일 뿐입니다. 친밀감, 성적 관심, 활동량에 정해진 양상은 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंडोत्सर्जन के आसपास अंडाणु निकलता है। सटीक समय बदल सकता है और केवल अनुमान रहता है; निकटता, यौन रुचि और सक्रियता किसी तय ढर्रे पर नहीं चलती।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навколо овуляції вивільняється яйцеклітина. Точний час може зміщуватися й лишається оцінкою; близькість, сексуальний інтерес і активність не мають фіксованого шаблону."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีการปล่อยเซลล์ไข่ในช่วงตกไข่ ช่วงเวลาที่แน่นอนอาจเลื่อนและยังเป็นเพียงการประเมิน ความใกล้ชิด ความสนใจทางเพศ และระดับกิจกรรมไม่ได้เป็นไปตามรูปแบบตายตัว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một trứng được giải phóng quanh thời điểm rụng trứng. Thời điểm chính xác có thể dịch chuyển và vẫn chỉ là ước tính; sự gần gũi, ham muốn tình dục và mức hoạt động không theo một khuôn mẫu cố định."
          }
        }
      }
    },
