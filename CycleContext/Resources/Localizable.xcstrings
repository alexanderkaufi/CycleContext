    "settings.privacy.consentHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten anderer Personen nur mit deren Wissen und Einverständnis erfassen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Only record another person's data with their knowledge and consent."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Only record another person's data with their knowledge and consent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’enregistrez les données d’une autre personne qu’avec son accord et si elle en est informée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra los datos de otra persona solo con su conocimiento y consentimiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre dados de outra pessoa apenas com o conhecimento e consentimento dela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i dati di un'altra persona solo con la sua conoscenza e il suo consenso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте данные другого человека только с его ведома и согласия."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تسجل بيانات شخص آخر إلا بعلمه وموافقته."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在對方知情並同意時，才記錄她的資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录他人的数据时，应先取得对方的知情与同意。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לתעד מידע על אדם אחר רק בידיעתו ובהסכמתו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの人のデータは、本人が知り、同意している場合だけ記録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람의 데이터는 본인이 알고 동의할 때만 기록하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी अन्य व्यक्ति की जानकारी केवल उनकी जानकारी और सहमति से दर्ज करें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте дані іншої людини лише з її відома та згоди."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูลของบุคคลอื่นเมื่อพวกเขารับรู้และยินยอมเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ghi dữ liệu của người khác khi họ biết và đồng ý."
          }
        }
      }
    },
