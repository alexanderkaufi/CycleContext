    "privacy.deletion.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einzelne Personen und ihre zugehörigen Einträge kannst du in der Personenverwaltung löschen. Wenn du die App vom iPhone löschst, werden die lokal gespeicherten App-Daten entfernt. „App auslagern“ behält die Daten dagegen auf dem Gerät."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete individual people and their related entries in profile management. Deleting the app from your iPhone removes its locally stored data. Offloading the app, however, keeps that data on the device."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You can delete individual people and their related entries in profile management. Deleting the app from your iPhone removes its locally stored data. Offloading the app, however, keeps that data on the device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez supprimer des personnes et leurs entrées associées dans la gestion des profils. Supprimer l’app de votre iPhone efface ses données stockées localement. En revanche, décharger l’app conserve ces données sur l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes eliminar personas y sus entradas relacionadas en la gestión de perfiles. Si eliminas la app de tu iPhone, se borran los datos guardados localmente. En cambio, si la desinstalas conservando sus datos, estos permanecen en el dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode excluir pessoas e seus registros relacionados no gerenciamento de perfis. Excluir o app do iPhone remove os dados armazenados localmente. Já desinstalar o app mantendo seus dados faz com que eles permaneçam no dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi eliminare singole persone e le relative voci nella gestione dei profili. Eliminando l'app dall'iPhone vengono rimossi i dati salvati localmente. Rimuovere l'app conservandone i dati, invece, lascia tali dati sul dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельных людей и связанные с ними записи можно удалить в управлении профилями. При удалении приложения с iPhone удаляются и его локальные данные. Если же выгрузить приложение, сохранив документы и данные, они останутся на устройстве."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك حذف الأشخاص وملاحظاتهم المرتبطة بهم من إدارة الملفات الشخصية. يؤدي حذف التطبيق من iPhone إلى إزالة بياناته المخزنة محليًا. أما إلغاء تحميل التطبيق مع الاحتفاظ ببياناته فيُبقي تلك البيانات على الجهاز."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在個人檔案管理中，刪除個別對象及相關紀錄。從 iPhone 刪除 App 會移除本機儲存的資料；卸載 App 則會將資料保留在裝置上。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在档案管理中删除单个档案及其相关记录。从 iPhone 删除 App 会移除本地保存的数据；卸载 App 则会将数据保留在设备上。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר למחוק אנשים ואת הרשומות הקשורות אליהם בניהול הפרופילים. מחיקת האפליקציה מה־iPhone מסירה את הנתונים השמורים מקומית. הסרת האפליקציה תוך שמירת הנתונים במכשיר אינה מוחקת אותם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィール管理で、人とその人に関連する記録を削除できます。iPhoneからアプリを削除すると、端末内の保存データも削除されます。ただし、アプリを取り除いてデータを残す操作では、データは端末に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 관리에서 사람과 관련 기록을 삭제할 수 있습니다. iPhone에서 앱을 삭제하면 기기에 저장된 데이터도 삭제됩니다. 앱만 제거하고 데이터를 유지하는 경우에는 데이터가 기기에 남습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप प्रोफ़ाइल प्रबंधन में अलग-अलग लोगों और उनके संबंधित रिकॉर्ड हटा सकते हैं। iPhone से ऐप हटाने पर स्थानीय रूप से सहेजा डेटा मिट जाता है। ऐप को ऑफ़लोड करने पर यह डेटा डिवाइस पर बना रहता है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У керуванні профілями можна видалити окремих людей і пов’язані з ними записи. Видалення програми з iPhone стирає локально збережені дані. Вивантаження програми, однак, залишає ці дані на пристрої."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถลบบุคคลแต่ละรายพร้อมบันทึกที่เกี่ยวข้องได้ในการจัดการโปรไฟล์ การลบแอปออกจาก iPhone จะลบข้อมูลที่จัดเก็บไว้ในเครื่อง แต่การเอาแอปออกชั่วคราวจะยังเก็บข้อมูลไว้บนอุปกรณ์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể xóa từng người và các ghi chép liên quan trong phần quản lý hồ sơ. Xóa ứng dụng khỏi iPhone sẽ xóa dữ liệu ứng dụng được lưu cục bộ. Tuy nhiên, gỡ bỏ ứng dụng tạm thời vẫn giữ dữ liệu trên thiết bị."
          }
        }
      }
    },
