    "profile.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zyklusdaten und Einträge dieser Person werden von diesem Gerät entfernt."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "This person's cycle data and entries will be removed from this device."
