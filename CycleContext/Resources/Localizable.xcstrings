    "dashboard.overdue.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne bestätigten neuen Beginn ist der aktuelle Zyklustag nicht sicher einzuordnen."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a confirmed new start, the current cycle day cannot be placed reliably."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a confirmed new start, the current cycle day cannot be placed reliably."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans nouveau début confirmé, il est impossible de situer de façon fiable le jour actuel du cycle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin un nuevo inicio confirmado, no se puede situar de forma fiable el día actual del ciclo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem um novo início confirmado, não é possível determinar com segurança o dia atual do ciclo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un nuovo inizio confermato, non è possibile collocare con affidabilità il giorno attuale del ciclo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без подтверждённой даты нового начала нельзя надёжно определить текущий день цикла."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من دون بداية جديدة مؤكدة، لا يمكن تحديد اليوم الحالي من الدورة على نحو موثوق."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有確認新的開始日，就無法可靠地判定目前處於週期的哪一天。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有确认新的开始日，就无法可靠地判定目前处于周期的哪一天。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ללא התחלה חדשה שאושרה, אי אפשר לקבוע באופן אמין את יום המחזור הנוכחי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい開始日が確認されていないため、現在が周期の何日目かを確実には示せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 시작일이 확인되지 않아 현재 주기의 날짜를 정확히 알 수 없습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई पुष्टि की गई शुरुआत के बिना वर्तमान चक्र दिन को भरोसेमंद ढंग से तय नहीं किया जा सकता।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без підтвердженого нового початку неможливо надійно визначити поточний день циклу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากยังไม่ยืนยันวันเริ่มใหม่ จะไม่สามารถระบุวันปัจจุบันของรอบเดือนได้อย่างน่าเชื่อถือ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu chưa xác nhận ngày bắt đầu mới, không thể xác định đáng tin cậy ngày hiện tại của chu kỳ."
          }
        }
      }
    },
    "dashboard.overdue.orientation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erwartete Zykluslänge ist überschritten. Bis ein neuer Periodenbeginn bestätigt wird, zeigt die App keine bestimmte Phase als aktuellen Zustand an."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The expected cycle length has passed. Until a new period start is confirmed, the app does not present any specific phase as the current state."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The expected cycle length has passed. Until a new period start is confirmed, the app does not present any specific phase as the current state."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée de cycle attendue est dépassée. Tant qu’un nouveau début de règles n’est pas confirmé, l’app ne présente aucune phase précise comme état actuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha superado la duración prevista del ciclo. Hasta que se confirme el inicio de otra menstruación, la app no presenta ninguna fase concreta como estado actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A duração esperada do ciclo já passou. Até que o início de uma nova menstruação seja confirmado, o app não apresenta nenhuma fase específica como estado atual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La durata prevista del ciclo è trascorsa. Finché non viene confermato un nuovo inizio, l'app non presenta una fase specifica come stato attuale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидаемая длительность цикла прошла. Пока новое начало менструации не подтверждено, приложение не показывает конкретную фазу как текущую."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقضى طول الدورة المتوقع. وحتى تأكيد بداية حيض جديدة، لا يعرض التطبيق مرحلة معينة بوصفها الحالة الحالية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預期的週期長度已過。在確認新的月經開始日前，App 不會將任何特定階段顯示為目前狀態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预期的周期长度已过。在确认新的月经开始日前，App 不会将任何特定阶段显示为目前状态。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אורך המחזור הצפוי חלף. עד שתאושר התחלה חדשה של הווסת, האפליקציה אינה מציגה שלב מסוים כמצב הנוכחי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予想される周期の長さを過ぎました。次の月経開始日が確認されるまで、特定の時期を現在の状態として表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예상 주기 길이가 지났습니다. 새 생리 시작일이 확인될 때까지 앱은 특정 단계를 현재 상태로 표시하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपेक्षित चक्र लंबाई बीत चुकी है। नई माहवारी की शुरुआत की पुष्टि होने तक ऐप किसी खास चरण को वर्तमान स्थिति के रूप में नहीं दिखाता।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікувана тривалість циклу минула. Поки новий початок менструації не підтверджено, програма не показує конкретну фазу як поточну."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผ่านความยาวรอบเดือนที่คาดไว้แล้ว จนกว่าจะยืนยันวันเริ่มมีประจำเดือนครั้งใหม่ แอปจะไม่แสดงระยะใดเป็นสถานะปัจจุบัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ dài chu kỳ dự kiến đã qua. Cho đến khi xác nhận ngày bắt đầu kỳ kinh mới, ứng dụng không hiển thị giai đoạn cụ thể nào là trạng thái hiện tại."
          }
        }
      }
    },
