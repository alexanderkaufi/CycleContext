    "cycle.content.menstruation.todayText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blutung oder Krämpfe können den Körper heute stärker belasten."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleeding or cramps may place a greater strain on the body today."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleeding or cramps may place a greater strain on the body today."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les saignements ou les crampes peuvent être plus éprouvants pour le corps aujourd’hui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy el sangrado o los cólicos pueden suponer un mayor esfuerzo para el cuerpo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje, o sangramento ou as cólicas podem exigir mais do corpo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanguinamento o crampi possono rendere questa giornata più faticosa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кровотечение или спазмы могут сегодня давать дополнительную нагрузку на организм."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يجعل النزف أو التقلصات هذا اليوم أشد إرهاقًا للجسم."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的出血或痙攣可能使身體承受較大負擔。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的出血或痉挛可能使身体承受较大负担。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דימום או התכווצויות עשויים להכביד היום על הגוף."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は出血や腹痛で体に負担がかかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 출혈이나 통증으로 몸이 더 힘들 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रक्तस्राव या ऐंठन आज शरीर पर अधिक दबाव डाल सकते हैं।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кровотеча або спазми сьогодні можуть сильніше навантажувати організм."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือดออกหรืออาการปวดเกร็งอาจทำให้ร่างกายรับภาระมากขึ้นในวันนี้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chảy máu hoặc co thắt có thể khiến cơ thể chịu nhiều áp lực hơn hôm nay."
          }
        }
      }
    },
    "cycle.content.ovulation_window.avoidText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nähe, Sex, Attraktivität oder besondere Leistungsfähigkeit aus dem Zyklustag ableiten."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not infer closeness, sex, attractiveness, or exceptional performance from the cycle day."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not infer closeness, sex, attractiveness, or exceptional performance from the cycle day."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne déduisez pas du jour du cycle un besoin de proximité, une envie de rapports sexuels, une plus grande attirance ou des performances exceptionnelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No deduzcas del día del ciclo que desea cercanía o sexo, que resulta más atractiva o que rendirá especialmente bien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deduza do dia do ciclo que ela deseja proximidade ou sexo, está mais atraente ou terá um desempenho excepcional."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non dedurre dal giorno del ciclo il desiderio di vicinanza o di sesso, l'attrattiva o prestazioni eccezionali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не делайте по дню цикла выводов о желании близости или секса, привлекательности либо исключительной работоспособности."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستنتج من يوم الدورة الرغبة في القرب أو الجنس أو الجاذبية أو أداءً استثنائيًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要根據週期日期推斷她想親近、發生性行為、具有吸引力或表現特別好。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要根据周期日期推断她想亲近、发生性行为、具有吸引力或表现特别好。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא להסיק מהיום במחזור על רצון לקרבה או למין, על משיכה או על ביצועים יוצאי דופן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周期の日数から、親密さや性行為への希望、魅力、特別な能力を推測しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주기의 날짜만으로 친밀감, 성관계 의사, 매력이나 특별한 능력을 추측하지 마세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चक्र के दिन से निकटता, सेक्स, आकर्षण या असाधारण प्रदर्शन का निष्कर्ष न निकालें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не робіть висновків про близькість, секс, привабливість чи надзвичайну працездатність за днем циклу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าสรุปเรื่องความใกล้ชิด เพศ ความน่าดึงดูด หรือสมรรถนะพิเศษจากวันของรอบเดือน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng suy diễn về sự gần gũi, tình dục, sức hấp dẫn hoặc hiệu suất đặc biệt từ ngày của chu kỳ."
          }
        }
      }
    },
