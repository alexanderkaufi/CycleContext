    "cycle.fourPhaseExplanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier biologische Hauptphasen. Die mögliche PMS-Zeit ist Teil der Lutealphase."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Four main biological phases. The possible PMS period is part of the luteal phase."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Four main biological phases. The possible PMS period is part of the luteal phase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre grandes phases biologiques. La période possible de SPM fait partie de la phase lutéale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro fases biológicas principales. El posible período de SPM forma parte de la fase lútea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro fases biológicas principais. O possível período de TPM faz parte da fase lútea."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quattro fasi biologiche principali. Il possibile periodo premestruale fa parte della fase luteale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре основные биологические фазы. Возможный период ПМС относится к лютеиновой фазе."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أربع مراحل بيولوجية رئيسية. وفترة ما قبل الحيض المحتملة جزء من الطور الأصفري."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "四個主要生理階段。可能的經前症候群時期屬於黃體期。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "四个主要生理阶段。可能出现经前症状的时期属于黄体期。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארבעה שלבים ביולוגיים עיקריים. התקופה האפשרית של תסמיני PMS היא חלק מהשלב הלוטאלי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生物学的な主要段階は四つです。PMS症状が起こり得る時期は黄体期の一部です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주요 생물학적 단계는 네 가지입니다. PMS 증상이 나타날 수 있는 시기는 황체기의 일부입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार मुख्य जैविक चरण। संभावित PMS समय ल्यूटियल चरण का हिस्सा है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чотири основні біологічні фази. Можливий період ПМС є частиною лютеїнової фази."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สี่ระยะทางชีววิทยาหลัก ช่วงที่อาจมี PMS เป็นส่วนหนึ่งของระยะลูเทียล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bốn giai đoạn sinh học chính. Thời gian có thể có PMS thuộc giai đoạn hoàng thể."
          }
        }
      }
    },
