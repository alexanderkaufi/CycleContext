    "privacy.introduction": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext hilft dir, Zyklusinformationen einer nahestehenden Person einzuordnen. Der verantwortungsvolle Umgang mit diesen persönlichen Angaben ist dabei besonders wichtig."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext helps you understand cycle information for someone close to you. Handling this personal information responsibly is especially important."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext helps you understand cycle information for someone close to you. Handling this personal information responsibly is especially important."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext vous aide à comprendre les informations relatives au cycle d’une personne proche. Il est particulièrement important de traiter ces informations personnelles de façon responsable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext te ayuda a comprender la información del ciclo de una persona cercana. Es especialmente importante tratar estos datos personales de forma responsable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O CycleContext ajuda você a entender informações sobre o ciclo de uma pessoa próxima. É especialmente importante lidar com esses dados pessoais de forma responsável."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext ti aiuta a comprendere le informazioni sul ciclo di una persona a te vicina. È particolarmente importante trattare questi dati personali in modo responsabile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext помогает вам понимать сведения о цикле близкого человека. Особенно важно обращаться с этой личной информацией ответственно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعدك CycleContext على فهم معلومات الدورة لشخص قريب منك. ومن المهم جدًا التعامل مع هذه المعلومات الشخصية بمسؤولية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext 協助你了解親近之人的週期資訊。妥善處理這些個人資訊尤其重要。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext 协助你了解亲近之人的周期信息。妥善处理这些个人信息尤其重要。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext עוזרת להבין מידע על המחזור של אדם קרוב. חשוב במיוחד לנהוג באחריות במידע אישי כזה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContextは、自分や身近な人の周期に関する情報を理解するためのアプリです。この個人的な情報は慎重に扱ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext는 자신이나 가까운 사람의 주기에 관한 정보를 이해하는 데 도움을 줍니다. 이런 개인 정보는 특히 신중하게 다뤄야 합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext आपको अपने किसी करीबी व्यक्ति की चक्र जानकारी समझने में मदद करता है। इस व्यक्तिगत जानकारी को ज़िम्मेदारी से संभालना विशेष रूप से महत्वपूर्ण है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext допомагає розуміти інформацію про цикл близької людини. Особливо важливо відповідально поводитися з цими особистими даними."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext ช่วยให้คุณเข้าใจข้อมูลรอบเดือนของคนใกล้ชิด การจัดการข้อมูลส่วนบุคคลนี้อย่างรับผิดชอบจึงสำคัญเป็นพิเศษ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext giúp bạn hiểu thông tin chu kỳ của người gần gũi. Việc xử lý có trách nhiệm những thông tin cá nhân này đặc biệt quan trọng."
          }
        }
      }
    },
    "privacy.medical.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App bietet allgemeine Orientierung. Sie ist keine Diagnose-, Verhütungs- oder Therapie-App und ersetzt keine medizinische Beratung."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The app provides general guidance. It is not intended for diagnosis, contraception, or treatment and does not replace medical advice."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The app provides general guidance. It is not intended for diagnosis, contraception, or treatment and does not replace medical advice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app fournit des indications générales. Elle n’est pas destinée au diagnostic, à la contraception ou au traitement et ne remplace pas un avis médical."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app ofrece orientación general. No está destinada al diagnóstico, la anticoncepción ni el tratamiento, y no sustituye el consejo médico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app oferece orientações gerais. Não se destina a diagnóstico, contracepção ou tratamento e não substitui orientações médicas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app fornisce indicazioni generali. Non è destinata a diagnosi, contraccezione o trattamenti e non sostituisce un parere medico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение даёт общие сведения. Оно не предназначено для диагностики, контрацепции или лечения и не заменяет консультацию врача."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقدم التطبيق إرشادات عامة. وهو غير مخصص للتشخيص أو منع الحمل أو العلاج، ولا يحل محل المشورة الطبية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 提供一般參考資訊，不用於診斷、避孕或治療，也不能取代醫療建議。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 提供一般参考信息，不用于诊断、避孕或治疗，也不能取代医疗建议。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה מספקת מידע כללי להתמצאות. היא אינה מיועדת לאבחון, למניעת היריון או לטיפול, ואינה מחליפה ייעוץ רפואי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが提供するのは一般的な目安です。診断、避妊、治療を目的とせず、医療上の助言に代わるものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 일반적인 참고 정보를 제공합니다. 진단, 피임 또는 치료를 위한 것이 아니며 의학적 조언을 대신하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप सामान्य मार्गदर्शन देता है। यह निदान, गर्भनिरोध या उपचार के लिए नहीं है और चिकित्सा सलाह का विकल्प नहीं है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма надає загальне орієнтування. Вона не призначена для діагностики, контрацепції чи лікування й не замінює медичну консультацію."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปให้แนวทางทั่วไป ไม่ได้มีไว้เพื่อการวินิจฉัย การคุมกำเนิด หรือการรักษา และไม่ใช้แทนคำแนะนำทางการแพทย์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng cung cấp hướng dẫn chung. Ứng dụng không dành cho chẩn đoán, tránh thai hoặc điều trị và không thay thế tư vấn y khoa."
          }
        }
      }
    },
