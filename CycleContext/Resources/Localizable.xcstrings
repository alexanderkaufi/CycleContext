    "cycle.education.sources.externalNote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Links öffnen externe Seiten. Für deren Inhalte und Datenschutz gelten die Angaben des jeweiligen Anbieters."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "These links open external websites. Their providers are responsible for their content and privacy information."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "These links open external websites. Their providers are responsible for their content and privacy information."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces liens ouvrent des sites externes. Leurs fournisseurs sont responsables de leur contenu et de leurs informations sur la protection des données."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos enlaces abren sitios web externos. Sus proveedores son responsables del contenido y de la información sobre privacidad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes links abrem sites externos. Seus responsáveis respondem pelo conteúdo e pelas informações sobre privacidade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi link aprono siti web esterni. I rispettivi gestori sono responsabili dei contenuti e delle informazioni sulla privacy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти ссылки открывают сторонние сайты. За их содержание и информацию о конфиденциальности отвечают владельцы сайтов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفتح هذه الروابط مواقع خارجية. ويتحمل مقدموها مسؤولية محتواها ومعلومات الخصوصية فيها."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些連結會開啟外部網站；其內容與隱私資訊由網站提供者負責。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些链接会打开外部网站；其内容与隐私信息由网站提供者负责。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישורים פותחים אתרים חיצוניים. ספקי האתרים אחראים לתוכן שלהם ולמידע על פרטיות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのリンクは外部サイトを開きます。内容とプライバシー情報については各サイトの提供者が責任を負います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크는 외부 웹사이트를 엽니다. 콘텐츠와 개인정보 처리에 대한 책임은 해당 사이트 제공자에게 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये लिंक बाहरी वेबसाइट खोलते हैं। उनकी सामग्री और गोपनीयता जानकारी के लिए उनके प्रदाता ज़िम्मेदार हैं।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці посилання відкривають зовнішні сайти. Їхні постачальники відповідають за вміст і політику конфіденційності."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลิงก์เหล่านี้เปิดเว็บไซต์ภายนอก ผู้ให้บริการแต่ละรายเป็นผู้รับผิดชอบเนื้อหาและข้อมูลความเป็นส่วนตัวของตน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các liên kết này mở trang web bên ngoài. Nhà cung cấp tương ứng chịu trách nhiệm về nội dung và thông tin quyền riêng tư của họ."
          }
        }
      }
    },
    "cycle.education.sources.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Texte beruhen auf allgemein anerkannten medizinischen Informationen. Die Links sind gesammelt aufgeführt, damit der Lesefluss nicht durch Quellenangaben in jedem Absatz unterbrochen wird."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is based on generally accepted medical information. Links are collected here so that references do not interrupt every paragraph."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is based on generally accepted medical information. Links are collected here so that references do not interrupt every paragraph."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte repose sur des informations médicales généralement admises. Les liens sont rassemblés ici pour ne pas interrompre chaque paragraphe avec des références."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se basa en información médica generalmente aceptada. Los enlaces se reúnen aquí para que las referencias no interrumpan cada párrafo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto se baseia em informações médicas geralmente aceitas. Os links estão reunidos aqui para que as referências não interrompam cada parágrafo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo si basa su informazioni mediche generalmente riconosciute. I link sono raccolti qui per non interrompere ogni paragrafo con riferimenti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст основан на общепринятых медицинских сведениях. Ссылки собраны здесь, чтобы не прерывать ими каждый абзац."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستند النص إلى معلومات طبية مقبولة عمومًا. وجُمعت الروابط هنا حتى لا تقاطع الإحالات كل فقرة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本文以普遍接受的醫學資訊為基礎。連結集中列於此處，避免在每個段落中打斷閱讀。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本文以普遍接受的医学信息为基础。链接集中列于此处，避免在每个段落中打断阅读。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטקסט מבוסס על מידע רפואי מקובל. הקישורים מרוכזים כאן כדי שההפניות לא יקטעו כל פסקה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文は一般に認められた医療情報に基づいています。読みやすさのため、参考リンクをここにまとめています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문은 일반적으로 받아들여지는 의학 정보를 바탕으로 합니다. 읽는 흐름을 방해하지 않도록 참고 링크를 여기에 모았습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पाठ सामान्य रूप से स्वीकार की गई चिकित्सा जानकारी पर आधारित है। संदर्भ हर अनुच्छेद में बाधा न डालें, इसलिए लिंक यहाँ इकट्ठे किए गए हैं।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст ґрунтується на загальновизнаній медичній інформації. Посилання зібрані тут, щоб джерела не переривали кожен абзац."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความอ้างอิงจากข้อมูลทางการแพทย์ที่ยอมรับโดยทั่วไป ลิงก์ต่าง ๆ ถูกรวบรวมไว้ที่นี่เพื่อไม่ให้แหล่งอ้างอิงขัดจังหวะการอ่านในทุกย่อหน้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản dựa trên thông tin y khoa được chấp nhận rộng rãi. Các liên kết được tập hợp tại đây để nguồn tham khảo không làm gián đoạn từng đoạn văn."
          }
        }
      }
    },
