    "calendar.estimate.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientierung, keine Diagnose oder Verhütungsprognose."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Guidance only, not a diagnosis or a contraceptive prediction."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Guidance only, not a diagnosis or a contraceptive prediction."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À titre indicatif uniquement ; ni diagnostic ni prédiction fiable pour la contraception."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo orientativo; no es un diagnóstico ni una predicción anticonceptiva fiable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para orientação; não é diagnóstico nem previsão confiável para contracepção."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo a scopo orientativo, non è una diagnosi né una previsione contraccettiva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для ориентира: это не диагноз и не надёжный способ контрацепции."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للاسترشاد فقط، وليس تشخيصًا أو وسيلة موثوقة لمنع الحمل."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供參考，不能用於診斷或預測避孕。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅供参考，不能用于诊断或避孕决策。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מידע להכוונה בלבד, לא אבחנה ולא שיטה לחיזוי לצורך מניעת היריון."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目安の情報です。診断や避妊のための予測ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고용 정보이며 진단이나 피임을 위한 예측이 아닙니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सामान्य मार्गदर्शन; यह निदान या गर्भनिरोध का अनुमान नहीं है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише для орієнтування, не для діагностики чи прогнозування контрацепції."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เป็นแนวทางเท่านั้น ไม่ใช่การวินิจฉัยหรือการคาดการณ์เพื่อคุมกำเนิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ để tham khảo, không phải chẩn đoán hoặc dự đoán để tránh thai."
          }
        }
      }
    },
