        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُزال بيانات دورة هذا الشخص وملاحظاته من هذا الجهاز."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對象的週期資料和紀錄將從這部裝置移除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此档案的周期数据和记录将从这台设备中删除。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני המחזור והרשומות של האדם הזה יוסרו מהמכשיר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人の周期データと記録を、この端末から削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람의 주기 데이터와 기록이 기기에서 삭제됩니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस व्यक्ति का चक्र डेटा और रिकॉर्ड इस डिवाइस से हटा दिए जाएँगे।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані циклу й записи цієї людини буде видалено з пристрою."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลรอบเดือนและบันทึกของบุคคลนี้จะถูกลบออกจากอุปกรณ์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu chu kỳ và ghi chép của người này sẽ bị xóa khỏi thiết bị."
          }
        }
      }
    },
