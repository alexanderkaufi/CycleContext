    "statistics.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswertung zeigt gespeicherte Muster und Planwerte, keine Diagnose oder Garantie für einzelne Tage."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The analysis shows saved patterns and planned values, not a diagnosis or a guarantee for individual days."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The analysis shows saved patterns and planned values, not a diagnosis or a guarantee for individual days."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’analyse montre les tendances enregistrées et les valeurs prévues, pas un diagnostic ni une garantie pour chaque jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis muestra patrones guardados y valores planificados, no un diagnóstico ni una garantía para días concretos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise mostra padrões registrados e valores planejados, não um diagnóstico nem uma garantia para dias específicos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analisi mostra gli schemi salvati e i valori pianificati, non una diagnosi né una garanzia per i singoli giorni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализ показывает сохранённые закономерности и запланированные значения, а не диагноз или гарантию для отдельных дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُظهر التحليل الأنماط المحفوظة والقيم المخطط لها، وليس تشخيصًا أو ضمانًا لأيام بعينها."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分析顯示已儲存的模式和規劃值，並非診斷，也不保證特定日期的情況。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析显示已保存的模式和规划值，并非诊断，也不保证特定日期的情况。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הניתוח מציג דפוסים שנשמרו וערכים מתוכננים, לא אבחנה או הבטחה לגבי ימים מסוימים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この分析は保存されたパターンと設定値を示すもので、診断や特定の日の保証ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 분석은 저장된 양상과 설정값을 보여 주며 진단이나 특정 날짜에 대한 보장이 아닙니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्लेषण सहेजे गए पैटर्न और नियोजित मान दिखाता है, किसी खास दिन के लिए निदान या गारंटी नहीं।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аналіз показує збережені закономірності й заплановані значення, а не діагноз чи гарантію для окремих днів."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การวิเคราะห์แสดงรูปแบบที่บันทึกไว้และค่าที่วางแผน ไม่ใช่การวินิจฉัยหรือการรับประกันสำหรับแต่ละวัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân tích hiển thị các khuôn mẫu đã lưu và giá trị dự kiến, không phải chẩn đoán hoặc bảo đảm cho từng ngày."
          }
        }
      }
    },
    "statistics.history.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen persönlichen Durchschnitt werden mindestens zwei Periodenbeginne benötigt."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "At least two period start dates are needed for a personal average."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "At least two period start dates are needed for a personal average."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut au moins deux dates de début de règles pour calculer une moyenne personnelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan al menos dos fechas de inicio de la menstruación para calcular un promedio personal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessárias pelo menos duas datas de início da menstruação para calcular uma média pessoal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono almeno due date di inizio delle mestruazioni per calcolare una media personale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для расчёта личного среднего нужны хотя бы две даты начала менструации."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم تاريخان على الأقل لبداية الحيض لحساب متوسط شخصي."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要兩個月經開始日，才能計算個人平均值。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要两个月经开始日，才能计算个人平均值。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשים לפחות שני תאריכי התחלה של הווסת כדי לחשב ממוצע אישי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人の平均値を計算するには、月経開始日を少なくとも2回記録する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 평균을 계산하려면 생리 시작일을 최소 두 번 기록해야 합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत औसत के लिए कम से कम दो माहवारी की शुरुआत की तारीखें चाहिए।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для особистого середнього потрібні щонайменше дві дати початку менструації."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องมีวันเริ่มมีประจำเดือนอย่างน้อยสองครั้งเพื่อคำนวณค่าเฉลี่ยส่วนบุคคล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần ít nhất hai ngày bắt đầu kỳ kinh để tính trung bình cá nhân."
          }
        }
      }
    },
