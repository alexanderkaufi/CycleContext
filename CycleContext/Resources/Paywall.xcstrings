    "switch.required.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte zuerst die automatische Verlängerung des Jahresabos aus. Danach kann Lifetime gekauft werden."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "First turn off automatic renewal for the annual subscription. You can then purchase Lifetime."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "First turn off automatic renewal for the annual subscription. You can then purchase Lifetime."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez d’abord le renouvellement automatique de l’abonnement annuel. Vous pourrez ensuite acheter l’accès permanent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero desactiva la renovación automática de la suscripción anual. Después podrás comprar el acceso permanente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, desative a renovação automática da assinatura anual. Depois, você poderá comprar o acesso permanente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva prima il rinnovo automatico dell'abbonamento annuale. Potrai poi acquistare l'accesso permanente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала отключите автопродление годовой подписки. После этого можно купить постоянный доступ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف أولًا التجديد التلقائي للاشتراك السنوي. وبعدها يمكنك شراء الوصول الدائم."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先關閉年度訂閱的自動續訂，再購買永久使用權限。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先关闭年度订阅的自动续订，再购买永久使用权限。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תחילה כבו את החידוש האוטומטי של המנוי השנתי. לאחר מכן תוכלו לרכוש גישה לכל החיים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず年間プランの自動更新をオフにしてください。その後、買い切りを購入できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 연간 구독의 자동 갱신을 끄세요. 그런 다음 평생 이용을 구매할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले वार्षिक सदस्यता का अपने आप नवीनीकरण बंद करें। उसके बाद आप आजीवन एक्सेस खरीद सकते हैं।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку вимкніть автоматичне поновлення річної підписки. Після цього можна придбати довічний доступ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการต่ออายุอัตโนมัติของสมาชิกรายปีก่อน จากนั้นคุณจึงซื้อสิทธิ์ตลอดชีพได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên hãy tắt tự động gia hạn cho gói hằng năm. Sau đó bạn có thể mua quyền trọn đời."
          }
        }
      }
    },
