    "switch.ready.detailFormat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Verlängerung ist beendet. Das bezahlte Abo bleibt bis %@ aktiv; Lifetime beginnt sofort."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic renewal is off. The paid subscription remains active until %@; Lifetime starts immediately."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic renewal is off. The paid subscription remains active until %@; Lifetime starts immediately."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renouvellement automatique est désactivé. L’abonnement payé reste actif jusqu’au %@ ; l’accès permanent commence immédiatement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La renovación automática está desactivada. La suscripción pagada sigue activa hasta el %@; el acceso permanente comienza inmediatamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A renovação automática está desativada. A assinatura paga permanece ativa até %@; o acesso permanente começa imediatamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rinnovo automatico è disattivato. L'abbonamento pagato resta attivo fino al %@; l'accesso permanente inizia subito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автопродление отключено. Оплаченная подписка действует до %@; постоянный доступ начнётся сразу."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التجديد التلقائي متوقف. يبقى الاشتراك المدفوع نشطًا حتى %@؛ ويبدأ الوصول الدائم فورًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動續訂已關閉。已付款的訂閱維持到 %@；永久使用權限立即生效。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动续订已关闭。已付款的订阅维持到 %@；永久使用权限立即生效。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החידוש האוטומטי כבוי. המנוי ששולם נשאר פעיל עד %@; הגישה לכל החיים מתחילה מיד."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動更新はオフです。年間プランは%@まで有効で、買い切りは購入後すぐに有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 갱신이 꺼져 있습니다. 결제한 구독은 %@까지 유지되며 평생 이용은 구매 즉시 시작됩니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आप नवीनीकरण बंद है। भुगतान सदस्यता %@ तक सक्रिय रहेगी; आजीवन एक्सेस तुरंत शुरू होगा।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автопоновлення вимкнено. Оплачена підписка діє до %@; довічний доступ починається одразу."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดการต่ออายุอัตโนมัติแล้ว สมาชิกที่ชำระเงินยังใช้ได้ถึง %@ และสิทธิ์ตลอดชีพจะเริ่มทันที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tắt tự động gia hạn. Gói đã thanh toán còn hiệu lực đến %@; quyền trọn đời bắt đầu ngay lập tức."
          }
        }
      }
    },
