        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנוי השנתי שלכם כבר פעיל. לא בוצעה רכישה נוספת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間サブスクリプションはすでに有効です。追加の購入は行われませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연간 구독이 이미 활성화되어 있습니다. 추가 구매는 이루어지지 않았습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी वार्षिक सदस्यता पहले से सक्रिय है। कोई अतिरिक्त खरीदारी नहीं हुई।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша річна підписка вже активна. Додаткової покупки не здійснено."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกรายปีของคุณเปิดใช้งานอยู่แล้ว จึงไม่มีการซื้อเพิ่มเติม"
