        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यक्तिगत डेटा आपके डिवाइस पर स्थानीय रूप से रहता है"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Особисті дані зберігаються локально на пристрої"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลส่วนบุคคลอยู่ในอุปกรณ์ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu cá nhân được lưu cục bộ trên thiết bị"
          }
        }
      }
    },
    "paywall.subscriptionDisclosure": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Jahresabo verlängert sich automatisch, sofern es nicht spätestens 24 Stunden vor Ende des aktuellen Zeitraums gekündigt wird. Die Zahlung erfolgt über dein Apple-Konto. Lifetime ist ein einmaliger Kauf."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The annual subscription renews automatically unless cancelled at least 24 hours before the end of the current period. Payment is charged to your Apple Account. Lifetime is a one-time purchase."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The annual subscription renews automatically unless canceled at least 24 hours before the end of the current period. Payment is charged to your Apple Account. Lifetime is a one-time purchase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement annuel se renouvelle automatiquement, sauf annulation au moins 24 heures avant la fin de la période en cours. Le paiement est débité de votre compte Apple. L’accès permanent est un achat unique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción anual se renueva automáticamente, salvo que se cancele al menos 24 horas antes de que termine el período actual. El pago se carga a tu cuenta de Apple. El acceso permanente es una compra única."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura anual é renovada automaticamente, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. O pagamento é cobrado da sua Conta Apple. O acesso permanente é uma compra única."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento annuale si rinnova automaticamente, salvo disdetta almeno 24 ore prima della fine del periodo in corso. Il pagamento viene addebitato sul tuo Apple Account. L'accesso permanente è un acquisto una tantum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Годовая подписка продлевается автоматически, если не отменить её не позднее чем за 24 часа до окончания текущего периода. Плата списывается с вашего Apple Account. Постоянный доступ оплачивается один раз."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجدد الاشتراك السنوي تلقائيًا ما لم يُلغَ قبل انتهاء الفترة الحالية بما لا يقل عن 24 ساعة. تُحصّل الدفعة من Apple Account الخاص بك. والوصول الدائم عملية شراء لمرة واحدة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "年度訂閱會自動續訂，除非在目前訂閱期結束前至少 24 小時取消。費用會從你的 Apple 帳號收取。永久使用權限為一次性購買。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "年度订阅会自动续订，除非在目前订阅期结束前至少 24 小时取消。费用会从你的 Apple 账号收取。永久使用权限为一次性购买。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המנוי השנתי מתחדש אוטומטית אלא אם מבטלים אותו לפחות 24 שעות לפני סוף התקופה הנוכחית. התשלום מחויב לחשבון Apple שלכם. גישה לכל החיים היא רכישה חד־פעמית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年間サブスクリプションは、現在の期間が終わる24時間以上前に解約しない限り自動更新されます。料金はApple Accountに請求されます。買い切りは一度きりの購入です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연간 구독은 현재 기간이 끝나기 최소 24시간 전에 취소하지 않으면 자동 갱신됩니다. 결제 금액은 Apple 계정으로 청구됩니다. 평생 이용은 일회성 구매입니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वार्षिक सदस्यता अपने आप नवीनीकृत होती है, जब तक मौजूदा अवधि समाप्त होने से कम से कम 24 घंटे पहले इसे रद्द न किया जाए। भुगतान आपके Apple Account से लिया जाता है। आजीवन एक्सेस एक बार की खरीदारी है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Річна підписка поновлюється автоматично, якщо її не скасувати щонайменше за 24 години до завершення поточного періоду. Платіж стягується з вашого Apple Account. Довічний доступ — одноразова покупка."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกรายปีจะต่ออายุโดยอัตโนมัติ เว้นแต่จะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบปัจจุบัน ระบบจะเรียกเก็บเงินจากบัญชี Apple ของคุณ สิทธิ์ตลอดชีพเป็นการซื้อครั้งเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đăng ký hằng năm tự động gia hạn trừ khi bị hủy ít nhất 24 giờ trước khi kết thúc kỳ hiện tại. Khoản thanh toán được tính vào Tài khoản Apple của bạn. Quyền trọn đời là giao dịch mua một lần."
          }
        }
      }
    },
    "paywall.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sieben Tage mit vollständigem Zugriff sind vorbei. Wähle, wie du CycleContext weiter nutzen möchtest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your seven days of full access have ended. Choose how you want to continue using CycleContext."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your seven days of full access have ended. Choose how you want to continue using CycleContext."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos sept jours d’accès complet sont terminés. Choisissez comment continuer à utiliser CycleContext."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han terminado tus siete días de acceso completo. Elige cómo quieres seguir usando CycleContext."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus sete dias de acesso completo terminaram. Escolha como deseja continuar usando o CycleContext."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi sette giorni di accesso completo sono terminati. Scegli come continuare a usare CycleContext."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семь дней полного доступа закончились. Выберите, как продолжить пользоваться CycleContext."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت أيام الوصول الكامل السبعة. اختر طريقة مواصلة استخدام CycleContext."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "七天的完整功能試用已結束。請選擇如何繼續使用 CycleContext。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "七天的完整功能试用已结束。请选择如何继续使用 CycleContext。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שבעת ימי הגישה המלאה הסתיימו. בחרו איך להמשיך להשתמש ב־CycleContext."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間の無料体験が終了しました。CycleContextの利用を続ける方法を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일간 모든 기능을 이용하는 무료 체험이 끝났습니다. CycleContext를 계속 사용하는 방법을 선택하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सात दिनों का पूरा एक्सेस समाप्त हो गया है। चुनें कि CycleContext का उपयोग कैसे जारी रखना है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сім днів повного доступу завершилися. Виберіть, як продовжити користуватися CycleContext."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิ์เข้าใช้เต็มรูปแบบ 7 วันสิ้นสุดแล้ว เลือกว่าคุณต้องการใช้ CycleContext ต่ออย่างไร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảy ngày truy cập đầy đủ đã kết thúc. Hãy chọn cách bạn muốn tiếp tục dùng CycleContext."
          }
        }
      }
    },
