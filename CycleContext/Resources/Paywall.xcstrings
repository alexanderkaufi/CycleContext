    "purchase.alreadyAnnual.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Jahresabo ist bereits aktiv. Es erfolgt kein weiterer Abschluss."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your annual subscription is already active. No additional purchase was made."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your annual subscription is already active. No additional purchase was made."
          }
        },
        "fr": {
