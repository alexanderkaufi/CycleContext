    "trialIntro.start.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sieben Tage beginnen erst, wenn du auf diesen Button tippst. Danach entscheidest du, ob und wie du CycleContext weiter nutzen möchtest."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The seven days begin only when you tap this button. Afterwards, you decide whether and how you want to continue using CycleContext."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The seven days begin only when you tap this button. Afterward, you decide whether and how you want to continue using CycleContext."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sept jours ne commencent que lorsque vous touchez ce bouton. Ensuite, vous décidez si et comment vous souhaitez continuer à utiliser CycleContext."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los siete días solo empiezan cuando tocas este botón. Después decides si quieres seguir usando CycleContext y cómo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sete dias começam somente quando você toca neste botão. Depois, você decide se e como deseja continuar usando o CycleContext."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I sette giorni iniziano solo quando tocchi questo pulsante. Dopo decidi tu se e come continuare a usare CycleContext."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семь дней начнутся только после нажатия этой кнопки. Затем вы сами решите, продолжать ли пользоваться CycleContext и каким способом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ الأيام السبعة فقط عند الضغط على هذا الزر. وبعدها تقرر ما إذا كنت تريد مواصلة استخدام CycleContext وكيفية ذلك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有點按此按鈕後，七天試用才會開始。之後由你決定是否及如何繼續使用 CycleContext。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有点按此按钮后，七天试用才会开始。之后由你决定是否及如何继续使用 CycleContext。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שבעת הימים מתחילים רק כשלוחצים על הכפתור הזה. אחר כך אתם מחליטים אם ואיך להמשיך להשתמש ב־CycleContext."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7日間の無料体験は、このボタンをタップしたときに始まります。その後、CycleContextを使い続けるか、どの方法で使うかを選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7일은 이 버튼을 탭한 뒤에만 시작됩니다. 이후 CycleContext를 계속 사용할지, 어떤 방법으로 사용할지 직접 선택할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सात दिन तभी शुरू होंगे जब आप इस बटन पर टैप करेंगे। उसके बाद आप तय करेंगे कि CycleContext का उपयोग जारी रखना है या नहीं और किस तरह करना है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сім днів почнуться лише після натискання цієї кнопки. Потім ви вирішите, чи продовжувати користуватися CycleContext і в який спосіб."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลา 7 วันจะเริ่มเมื่อคุณแตะปุ่มนี้เท่านั้น หลังจากนั้นคุณเป็นผู้ตัดสินใจว่าจะใช้ CycleContext ต่อหรือไม่และในรูปแบบใด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảy ngày chỉ bắt đầu khi bạn chạm vào nút này. Sau đó, bạn quyết định có tiếp tục dùng CycleContext hay không và theo cách nào."
          }
        }
      }
    },
    "trialIntro.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lerne CycleContext in Ruhe kennen – vollständig, kostenlos und ohne Zahlungsangabe."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore all of CycleContext at your own pace, free and without payment details."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore all of CycleContext at your own pace, free and without payment details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez tout CycleContext à votre rythme, gratuitement et sans informations de paiement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora todo CycleContext a tu ritmo, gratis y sin datos de pago."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conheça todos os recursos do CycleContext no seu ritmo, grátis e sem informar dados de pagamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri tutte le funzioni di CycleContext con i tuoi tempi, gratis e senza dati di pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знакомьтесь со всеми возможностями CycleContext в своём темпе — бесплатно и без платёжных данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتشف CycleContext على مهل، مجانًا ومن دون بيانات دفع."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按照自己的步調探索 CycleContext 的所有功能，免費且無須提供付款資料。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按照自己的步调探索 CycleContext 的所有功能，免费且无须提供付款信息。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גלו את CycleContext בקצב שלכם, בחינם וללא פרטי תשלום."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い情報なしで、CycleContextのすべての機能を自分のペースで試せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 정보 없이 CycleContext의 모든 기능을 원하는 속도로 살펴보세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "CycleContext की सभी सुविधाएँ अपनी गति से, मुफ़्त और भुगतान जानकारी के बिना देखें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ознайомтеся з усіма функціями CycleContext у власному темпі, безкоштовно й без платіжних даних."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำรวจทุกฟังก์ชันของ CycleContext ได้ตามจังหวะของคุณ ฟรีและไม่ต้องใช้ข้อมูลการชำระเงิน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khám phá toàn bộ CycleContext theo nhịp độ của bạn, miễn phí và không cần thông tin thanh toán."
          }
        }
      }
    },
