    "switch.card.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App führt dich zuerst zur Kündigung der automatischen Aboverlängerung und prüft anschließend den Status."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The app first guides you to turn off automatic renewal, then checks the status."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The app first guides you to turn off automatic renewal, then checks the status."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app vous aide d’abord à désactiver le renouvellement automatique, puis vérifie son statut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app primero te guía para desactivar la renovación automática y después comprueba su estado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app primeiro ajuda você a desativar a renovação automática e depois verifica o status."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app ti guida prima a disattivare il rinnovo automatico, poi verifica lo stato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение сначала поможет отключить автопродление, а затем проверит статус."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعدك التطبيق أولًا على إيقاف التجديد التلقائي، ثم يتحقق من الحالة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 會先引導你關閉自動續訂，再檢查狀態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 会先引导你关闭自动续订，再检查状态。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה תדריך אתכם לכבות תחילה את החידוש האוטומטי ואז תבדוק את המצב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず自動更新をオフにする方法をご案内し、その後で状況を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 자동 갱신을 끄는 방법을 안내하고 상태를 확인합니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप पहले अपने आप नवीनीकरण बंद करने में मार्गदर्शन करता है, फिर स्थिति जाँचता है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма спочатку допоможе вимкнути автопоновлення, а потім перевірить стан."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปจะนำคุณไปปิดการต่ออายุอัตโนมัติก่อน แล้วจึงตรวจสอบสถานะ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng sẽ hướng dẫn bạn tắt tự động gia hạn trước, rồi kiểm tra trạng thái."
          }
        }
      }
    },
