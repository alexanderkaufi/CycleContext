    "purchase.error.verification": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht sicher bestätigt werden. Es wurde kein Zugang freigeschaltet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase couldn’t be securely verified. Access wasn’t granted."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase couldn’t be securely verified. Access wasn’t granted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’a pas pu être vérifié de façon sécurisée. L’accès n’a pas été accordé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la compra de forma segura. No se concedió el acceso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a compra com segurança. O acesso não foi concedido."
          }
        },
        "it": {
