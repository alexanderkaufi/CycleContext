          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile caricare le offerte dall'App Store. Controlla la connessione e riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить предложения из App Store. Проверьте подключение и попробуйте ещё раз."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحميل العروض من App Store. تحقق من اتصالك وحاول مجددًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從 App Store 載入方案。請檢查網路連線後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从 App Store 加载方案。请检查网络连接后再试。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הצלחנו לטעון את ההצעות מ־App Store. בדקו את החיבור ונסו שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeからプランを読み込めませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 상품을 불러올 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store से ऑफ़र लोड नहीं हो सके। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити пропозиції з App Store. Перевірте з’єднання й спробуйте ще раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถโหลดข้อเสนอจาก App Store ได้ โปรดตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
