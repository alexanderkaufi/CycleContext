    "switch.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende zuerst die automatische Verlängerung deines Jahresabos in Apples Abonnementverwaltung. Nach deiner Rückkehr prüft CycleContext den Status. Erst danach wird der Lifetime-Kauf freigeschaltet."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "First turn off automatic renewal for your annual subscription in Apple’s subscription management. When you return, CycleContext checks the status. Only then is the Lifetime purchase enabled."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "First turn off automatic renewal for your annual subscription in Apple’s subscription management. When you return, CycleContext checks the status. Only then is the Lifetime purchase enabled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez d’abord le renouvellement automatique de votre abonnement annuel dans la gestion des abonnements Apple. À votre retour, CycleContext vérifiera son statut. L’achat de l’accès permanent ne sera disponible qu’ensuite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero desactiva la renovación automática de tu suscripción anual en la gestión de suscripciones de Apple. Cuando vuelvas, CycleContext comprobará el estado. Solo entonces se habilitará la compra del acceso permanente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, desative a renovação automática da sua assinatura anual no gerenciamento de assinaturas da Apple. Quando você voltar, o CycleContext verificará o status. Só então a compra do acesso permanente será liberada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per prima cosa disattiva il rinnovo automatico dell'abbonamento annuale nella gestione degli abbonamenti Apple. Al tuo ritorno, CycleContext verifica lo stato. Solo allora potrai acquistare l'accesso permanente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала отключите автоматическое продление годовой подписки в настройках подписок Apple. Когда вы вернётесь, CycleContext проверит её статус. Только после этого станет доступна покупка постоянного доступа."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف أولًا التجديد التلقائي لاشتراكك السنوي من إدارة اشتراكات Apple. وعند عودتك، يتحقق CycleContext من الحالة. عندها فقط يصبح شراء الوصول الدائم متاحًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 Apple 的訂閱管理頁面關閉年度訂閱的自動續訂。返回 App 後，CycleContext 會檢查狀態；確認後才能購買永久使用權限。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 Apple 的订阅管理页面关闭年度订阅的自动续订。返回 App 后，CycleContext 会检查状态；确认后才能购买永久使用权限。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תחילה כבו את החידוש האוטומטי של המנוי השנתי בניהול המנויים של Apple. כשאתם חוזרים, CycleContext בודקת את המצב. רק אז תתאפשר רכישה של גישה לכל החיים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずAppleのサブスクリプション管理で、年間プランの自動更新をオフにしてください。アプリに戻るとCycleContextが状況を確認します。その後に買い切りを購入できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Apple의 구독 관리에서 연간 구독의 자동 갱신을 끄세요. 앱으로 돌아오면 CycleContext가 상태를 확인합니다. 그런 다음 평생 이용을 구매할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले Apple के सदस्यता प्रबंधन में अपनी वार्षिक सदस्यता का अपने आप नवीनीकरण बंद करें। लौटने पर CycleContext स्थिति जाँचता है। उसके बाद ही आजीवन खरीदारी उपलब्ध होती है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку вимкніть автоматичне поновлення річної підписки в керуванні підписками Apple. Після повернення CycleContext перевірить стан. Лише тоді стане доступна довічна покупка."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขั้นแรกให้ปิดการต่ออายุอัตโนมัติของสมาชิกรายปีในการจัดการการสมัครสมาชิกของ Apple เมื่อกลับมา CycleContext จะตรวจสอบสถานะ จากนั้นจึงเปิดให้ซื้อสิทธิ์ตลอดชีพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước tiên, hãy tắt tự động gia hạn cho gói hằng năm trong phần quản lý đăng ký của Apple. Khi bạn quay lại, CycleContext sẽ kiểm tra trạng thái. Chỉ sau đó mới có thể mua quyền trọn đời."
          }
        }
      }
    },
