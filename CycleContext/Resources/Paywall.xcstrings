    "purchase.alreadyLifetime.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du besitzt bereits dauerhaften Zugang. Ein zusätzliches Abo wird nicht abgeschlossen."
          }
        },
        "en-GB": {
