          "stringUnit": {
            "state": "translated",
            "value": "आजीवन एक्सेस पर जाएँ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейти на довічний доступ"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนเป็นสิทธิ์ตลอดชีพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang quyền trọn đời"
          }
        }
      }
    },
    "switch.noRefund.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der bereits bezahlte Abozeitraum läuft bis zu seinem Enddatum weiter. Apple verrechnet den verbleibenden Zeitraum nicht mit dem Lifetime-Kauf."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your paid subscription period continues until its end date. Apple doesn’t credit the remaining period towards the Lifetime purchase."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your paid subscription period continues until its end date. Apple doesn’t credit the remaining period toward the Lifetime purchase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre période d’abonnement payée continue jusqu’à sa date de fin. Apple ne déduit pas la période restante du prix de l’accès permanent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu período de suscripción pagado continúa hasta su fecha de finalización. Apple no descuenta el tiempo restante del precio del acceso permanente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O período pago da sua assinatura continua até a data de término. A Apple não desconta o período restante do preço do acesso permanente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il periodo di abbonamento pagato continua fino alla sua scadenza. Apple non detrae il periodo residuo dal prezzo dell'accesso permanente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплаченный период подписки действует до окончания. Apple не засчитывает оставшийся срок в стоимость постоянного доступа."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر فترة الاشتراك المدفوعة حتى نهايتها. ولا تخصم Apple قيمة المدة المتبقية من ثمن الوصول الدائم."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已付款的訂閱期間會持續到期。Apple 不會將剩餘期間的費用折抵永久使用權限購買金額。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已付款的订阅期间会持续到期。Apple 不会将剩余期间的费用折抵永久使用权限购买金额。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקופה שכבר שילמתם עליה נמשכת עד תאריך הסיום. Apple אינה מקזזת את יתרת התקופה ממחיר הגישה לכל החיים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い済み期間は終了日まで続きます。Appleは残りの期間を買い切り価格から差し引きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 결제한 구독 기간은 종료일까지 계속됩니다. Apple은 남은 기간을 평생 이용 구매 가격에서 공제하지 않습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी भुगतान की गई सदस्यता अवधि अपनी समाप्ति तारीख तक जारी रहती है। Apple बची अवधि को आजीवन खरीदारी में समायोजित नहीं करता।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оплачений період підписки триває до дати завершення. Apple не зараховує його залишок у вартість довічної покупки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะเวลาสมาชิกที่ชำระเงินแล้วจะดำเนินต่อไปจนถึงวันสิ้นสุด Apple จะไม่นำมูลค่าระยะเวลาที่เหลือไปหักจากการซื้อสิทธิ์ตลอดชีพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian đăng ký đã thanh toán tiếp tục đến ngày kết thúc. Apple không khấu trừ thời gian còn lại vào giao dịch mua quyền trọn đời."
          }
        }
      }
    },
