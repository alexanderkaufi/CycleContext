    "switch.ready.body.noDate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bestätigt, dass sich dein Jahresabo nicht mehr automatisch verlängert. Lifetime kann jetzt sicher gekauft werden."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple confirms that your annual subscription will no longer renew automatically. Lifetime can now be purchased safely."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple confirms that your annual subscription will no longer renew automatically. Lifetime can now be purchased safely."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple confirme que votre abonnement annuel ne se renouvellera plus automatiquement. Vous pouvez maintenant acheter l’accès permanent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple confirma que tu suscripción anual ya no se renovará automáticamente. Ahora puedes comprar el acceso permanente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple confirmou que sua assinatura anual não será mais renovada automaticamente. Agora você pode comprar o acesso permanente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple conferma che l'abbonamento annuale non si rinnoverà più automaticamente. Ora puoi acquistare l'accesso permanente in sicurezza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple подтверждает, что годовая подписка больше не будет автоматически продлеваться. Теперь можно безопасно купить постоянный доступ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تؤكد Apple أن اشتراكك السنوي لن يتجدد تلقائيًا بعد الآن. يمكنك الآن شراء الوصول الدائم بأمان."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已確認你的年度訂閱不會再自動續訂。現在可以安心購買永久使用權限。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已确认你的年度订阅不会再自动续订。现在可以安心购买永久使用权限。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple מאשרת שהמנוי השנתי שלכם כבר לא יתחדש אוטומטית. כעת אפשר לרכוש גישה לכל החיים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleにより、年間プランが自動更新されないことを確認しました。買い切りを購入できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 연간 구독이 더는 자동 갱신되지 않음을 확인했습니다. 이제 평생 이용을 구매할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple पुष्टि करता है कि आपकी वार्षिक सदस्यता अब अपने आप नवीनीकृत नहीं होगी। अब आजीवन एक्सेस सुरक्षित रूप से खरीदा जा सकता है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple підтверджує, що річна підписка більше не поновлюватиметься автоматично. Тепер довічний доступ можна придбати безпечно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ยืนยันว่าสมาชิกรายปีของคุณจะไม่ต่ออายุโดยอัตโนมัติอีก ตอนนี้คุณสามารถซื้อสิทธิ์ตลอดชีพได้อย่างปลอดภัย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple xác nhận gói hằng năm của bạn sẽ không tự động gia hạn nữa. Giờ đây bạn có thể mua quyền trọn đời một cách an toàn."
          }
        }
      }
    },
    "switch.ready.bodyFormat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bestätigt: Dein Jahresabo verlängert sich nicht mehr und bleibt bis %@ aktiv. Lifetime kann jetzt sicher gekauft werden."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple confirms: Your annual subscription won’t renew and remains active until %@. Lifetime can now be purchased safely."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple confirms: Your annual subscription won’t renew and remains active until %@. Lifetime can now be purchased safely."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple confirme que votre abonnement annuel ne se renouvellera pas et reste actif jusqu’au %@. Vous pouvez maintenant acheter l’accès permanent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple confirma que tu suscripción anual no se renovará y seguirá activa hasta el %@. Ahora puedes comprar el acceso permanente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple confirmou que sua assinatura anual não será renovada e permanece ativa até %@. Agora você pode comprar o acesso permanente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple conferma: l'abbonamento annuale non si rinnoverà e resterà attivo fino al %@. Ora puoi acquistare l'accesso permanente in sicurezza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple подтверждает: годовая подписка не продлится и останется активной до %@. Теперь можно безопасно купить постоянный доступ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تؤكد Apple أن الاشتراك السنوي لن يتجدد، وسيبقى نشطًا حتى %@. يمكنك الآن شراء الوصول الدائم بأمان."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已確認：你的年度訂閱不會續訂，使用權限維持到 %@。現在可以安心購買永久使用權限。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 已确认：你的年度订阅不会续订，使用权限维持到 %@。现在可以安心购买永久使用权限。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple מאשרת: המנוי השנתי שלכם לא יתחדש ונשאר פעיל עד %@. כעת אפשר לרכוש גישה לכל החיים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleにより、年間プランが自動更新されず、%@まで有効であることを確認しました。買い切りを購入できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple에서 연간 구독이 갱신되지 않고 %@까지 활성화됨을 확인했습니다. 이제 평생 이용을 구매할 수 있습니다."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple पुष्टि करता है: आपकी वार्षिक सदस्यता नवीनीकृत नहीं होगी और %@ तक सक्रिय रहेगी। अब आजीवन एक्सेस सुरक्षित रूप से खरीदा जा सकता है।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple підтверджує: річна підписка не поновиться й діятиме до %@. Тепер довічний доступ можна придбати безпечно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ยืนยันแล้ว: สมาชิกรายปีของคุณจะไม่ต่ออายุและยังใช้ได้ถึง %@ ตอนนี้คุณสามารถซื้อสิทธิ์ตลอดชีพได้อย่างปลอดภัย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple xác nhận: Gói hằng năm của bạn sẽ không gia hạn và còn hiệu lực đến %@. Giờ đây bạn có thể mua quyền trọn đời một cách an toàn."
          }
        }
      }
    },
