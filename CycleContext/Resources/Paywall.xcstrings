    "status.doublePayment.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dein Apple-Konto ist zusätzlich ein verlängerndes Jahresabo aktiv. Schalte die Verlängerung aus, damit keine weitere Jahreszahlung erfolgt."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple Account also has a renewing annual subscription. Turn off renewal to prevent another annual charge."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple Account also has a renewing annual subscription. Turn off renewal to prevent another annual charge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte Apple possède également un abonnement annuel renouvelable. Désactivez son renouvellement pour éviter un nouveau prélèvement annuel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta de Apple también tiene una suscripción anual que se renueva. Desactiva la renovación para evitar otro cargo anual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua Conta Apple também tem uma assinatura anual com renovação automática. Desative a renovação para evitar outra cobrança anual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Apple Account ha anche un abbonamento annuale con rinnovo automatico. Disattiva il rinnovo per evitare un ulteriore addebito annuale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вашем Apple Account также есть годовая подписка с автопродлением. Отключите продление, чтобы избежать ещё одного ежегодного списания."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد أيضًا اشتراك سنوي يتجدد تلقائيًا في Apple Account الخاص بك. أوقف التجديد لتجنب خصم سنوي إضافي."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Apple 帳號另有一筆會續訂的年度訂閱。請關閉續訂，以免再次收取年度費用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Apple 账号另有一笔会续订的年度订阅。请关闭续订，以免再次收取年度费用。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחשבון Apple שלכם יש גם מנוי שנתי שמתחדש. כבו את החידוש כדי למנוע חיוב שנתי נוסף."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このApple Accountには、自動更新される年間プランもあります。翌年の請求を避けるには更新をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 계정에 자동 갱신되는 연간 구독도 있습니다. 다음 연간 결제를 막으려면 갱신을 끄세요."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Apple Account में नवीनीकृत होने वाली वार्षिक सदस्यता भी है। एक और वार्षिक शुल्क से बचने के लिए नवीनीकरण बंद करें।"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вашому Apple Account також є річна підписка з поновленням. Вимкніть поновлення, щоб уникнути ще одного річного списання."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัญชี Apple ของคุณยังมีสมาชิกรายปีที่ต่ออายุอยู่ ปิดการต่ออายุเพื่อป้องกันการเรียกเก็บเงินรายปีอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản Apple của bạn cũng có một gói hằng năm đang gia hạn. Hãy tắt gia hạn để tránh một khoản phí hằng năm khác."
          }
        }
      }
    },
