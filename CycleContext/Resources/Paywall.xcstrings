    "purchase.error.products": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angebote konnten nicht aus dem App Store geladen werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The offers couldn’t be loaded from the App Store. Check your connection and try again."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "The offers couldn’t be loaded from the App Store. Check your connection and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les offres depuis l’App Store. Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar las ofertas del App Store. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "pt-BR": {
