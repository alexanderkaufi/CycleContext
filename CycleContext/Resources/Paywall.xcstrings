          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراكك السنوي نشط بالفعل. لم تُجرَ عملية شراء إضافية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的年度訂閱已啟用，沒有進行額外購買。"
